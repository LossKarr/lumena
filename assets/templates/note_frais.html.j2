<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:16mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.head{display:flex;justify-content:space-between;align-items:flex-start}.head h1{color:{{ accent }};font-size:27px;margin:0}.employee{background:#f5f7fa;border:1px solid #e4e7ec;padding:14px;margin:20px 0;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:8px;text-align:left}td{padding:9px;border-bottom:1px solid #e4e7ec}.money{text-align:right}.summary{width:300px;margin:18px 0 0 auto}.summary td:first-child{font-weight:600}.grand{background:#1c2430;color:#fff}.approval{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:35px}.box{border:1px solid #d0d5dd;height:80px;padding:10px}
</style></head><body><header class="head"><div><h1>NOTE DE FRAIS</h1><p>N° {{ numero }} · {{ periode }}</p></div><div>{{ date }}</div></header><section class="employee"><div><strong>Collaborateur</strong><br>{{ collaborateur.name }}</div><div><strong>Matricule</strong><br>{{ collaborateur.matricule }}</div><div><strong>Service</strong><br>{{ collaborateur.service }}</div></section><table><thead><tr><th>Date</th><th>Catégorie</th><th>Objet</th><th>Montant TTC</th><th>TVA</th></tr></thead><tbody>{% set ns=namespace(total=0,vat=0) %}{% for expense in expenses %}{% set ns.total=ns.total+(expense.amount|float) %}{% set ns.vat=ns.vat+(expense.vat|float) %}<tr><td>{{ expense.date }}</td><td>{{ expense.category }}</td><td>{{ expense.description }}</td><td class="money">{{ '%.2f'|format(expense.amount|float) }} {{ currency }}</td><td class="money">{{ '%.2f'|format(expense.vat|float) }} {{ currency }}</td></tr>{% endfor %}</tbody></table><table class="summary"><tr><td>Total dépenses</td><td class="money">{{ '%.2f'|format(ns.total) }} {{ currency }}</td></tr><tr><td>Avance reçue</td><td class="money">{{ '%.2f'|format(avance|float) }} {{ currency }}</td></tr><tr class="grand"><td>À REMBOURSER</td><td class="money">{{ '%.2f'|format(ns.total-(avance|float)) }} {{ currency }}</td></tr></table><section class="approval"><div class="box"><strong>Déclarant</strong><br>Date et signature</div><div class="box"><strong>Validation manager</strong><br>Date et signature</div></section></body></html>
