<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4 landscape;margin:14mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:9.5px}.head{display:flex;justify-content:space-between;align-items:end;border-bottom:4px solid {{ accent }};padding-bottom:12px}.head h1{color:{{ accent }};font-size:25px;margin:0}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.fact{background:#f5f7fa;border:1px solid #e4e7ec;padding:9px}.objective{border-left:5px solid {{ accent }};padding:11px;background:#f8fafc;margin:15px 0}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #e4e7ec}.status{font-weight:bold}.footer{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}.panel{border:1px solid #d0d5dd;padding:11px}.panel h2{font-size:13px;color:{{ accent }};margin-top:0}
</style></head><body><header class="head"><div><h1>PLAN D'ACTION</h1><p>{{ title }}</p></div><span>Mis à jour le {{ date }}</span></header><section class="facts"><div class="fact"><strong>Commanditaire</strong><br>{{ sponsor }}</div><div class="fact"><strong>Responsable</strong><br>{{ owner }}</div><div class="fact"><strong>Période</strong><br>{{ period }}</div></section><div class="objective"><strong>Objectif :</strong> {{ objective }}</div><table><thead><tr><th>ID</th><th>Action</th><th>Responsable</th><th>Échéance</th><th>Priorité</th><th>Statut</th><th>Indicateur</th></tr></thead><tbody>{% for item in actions %}<tr><td>{{ item.id }}</td><td>{{ item.action }}</td><td>{{ item.owner }}</td><td>{{ item.due }}</td><td>{{ item.priority }}</td><td class="status">{{ item.status }}</td><td>{{ item.indicator }}</td></tr>{% endfor %}</tbody></table><section class="footer"><div class="panel"><h2>Gouvernance</h2>{{ governance }}</div><div class="panel"><h2>Critères de succès</h2><ul>{% for item in success_metrics %}<li>{{ item }}</li>{% endfor %}</ul></div></section></body></html>
