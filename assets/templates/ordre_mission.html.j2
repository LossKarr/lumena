<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:20mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{display:flex;justify-content:space-between;border-bottom:4px solid {{ accent }};padding-bottom:14px}.head h1{color:{{ accent }};font-size:26px;margin:0}.employee{background:#f5f7fa;border:1px solid #e4e7ec;padding:15px;margin:22px 0}.trip{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.field{border-left:3px solid {{ accent }};padding:9px 12px;background:#fafafa}.field small{display:block;color:#667085;text-transform:uppercase}.objective{margin:18px 0;padding:14px;border:1px solid #d0d5dd}.sign{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:38px}.sign div{height:75px;border-top:1px solid #667085;padding-top:8px}
</style></head><body><header class="head"><div><h1>ORDRE DE MISSION</h1><p>N° {{ numero }}</p></div><div style="text-align:right"><strong>{{ employeur.name }}</strong><br>{{ employeur.address }}<br>{{ employeur.city }}</div></header><section class="employee"><strong>Collaborateur missionné</strong><p>{{ collaborateur.name }} · Matricule {{ collaborateur.matricule }}</p></section><div class="objective"><strong>Objet de la mission</strong><p>{{ objet }}</p></div><section class="trip"><div class="field"><small>Destination</small><strong>{{ destination }}</strong></div><div class="field"><small>Période</small>{{ date_debut }} au {{ date_fin }}</div><div class="field"><small>Transport</small>{{ transport }}</div><div class="field"><small>Hébergement</small>{{ hebergement }}</div><div class="field"><small>Budget autorisé</small>{{ budget }}</div><div class="field"><small>Contact</small>{{ contact }}</div></section><section class="sign"><div>Autorisation employeur<br>Date et signature</div><div>Collaborateur<br>Date et signature</div></section></body></html>
