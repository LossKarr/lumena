<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.head{display:flex;justify-content:space-between;border-bottom:4px solid {{ accent }};padding-bottom:14px}.head h1{color:{{ accent }};font-size:25px;margin:0}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.fact{background:#f5f7fa;padding:10px;border:1px solid #e4e7ec}.fact small{display:block;color:#667085}h2{font-size:14px;color:{{ accent }};margin:18px 0 7px}.panel{border:1px solid #d0d5dd;padding:12px;min-height:45px}.result{border-left:5px solid {{ accent }};background:#f0fdf4;padding:14px;margin-top:18px}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #e4e7ec}.sign{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:30px}.sign div{height:70px;border-top:1px solid #667085;padding-top:8px}
</style></head><body><header class="head"><div><h1>RAPPORT D'INTERVENTION</h1><p>N° {{ numero }}</p></div><div style="text-align:right"><strong>{{ prestataire.name }}</strong><br>Client : {{ client.name }}</div></header><section class="facts"><div class="fact"><small>Date</small>{{ date_intervention }}</div><div class="fact"><small>Horaire</small>{{ start_time }}–{{ end_time }}</div><div class="fact"><small>Site</small>{{ site }}</div><div class="fact"><small>Technicien</small>{{ technicien }}</div></section><h2>Demande initiale</h2><div class="panel">{{ request }}</div><h2>Diagnostic</h2><div class="panel">{{ diagnosis }}</div><h2>Actions réalisées</h2><ol>{% for action in actions %}<li>{{ action }}</li>{% endfor %}</ol><h2>Pièces / ressources</h2><table><thead><tr><th>Référence</th><th>Désignation</th><th>Qté</th></tr></thead><tbody>{% for item in parts %}<tr><td>{{ item.ref }}</td><td>{{ item.label }}</td><td>{{ item.qty }}</td></tr>{% endfor %}</tbody></table><div class="result"><strong>Résultat :</strong> {{ result }}<br><strong>Suivi :</strong> {{ follow_up }}</div><section class="sign"><div>Technicien</div><div>Client</div></section></body></html>
