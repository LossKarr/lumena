<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.hero{background:#1c2430;color:white;padding:22px;border-left:8px solid {{ accent }}}.hero h1{color:white;margin:0;font-size:25px}.severity{display:inline-block;background:#b42318;color:#fff;padding:4px 9px;margin-top:8px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}.fact{background:#f5f7fa;border:1px solid #e4e7ec;padding:10px}.fact small{display:block;color:#667085}h2{font-size:14px;color:{{ accent }};border-bottom:1px solid #e4e7ec;padding-bottom:5px}.timeline{border-left:3px solid {{ accent }};padding-left:15px}.event{margin:10px 0}.event strong{color:{{ accent }}}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #e4e7ec}
</style></head><body><header class="hero"><h1>RAPPORT D'INCIDENT</h1><p>N° {{ numero }}</p><span class="severity">Sévérité : {{ severity }}</span></header><section class="facts"><div class="fact"><small>Signalé par</small>{{ reported_by }}</div><div class="fact"><small>Date / heure</small>{{ incident_date }}</div><div class="fact"><small>Environnement</small>{{ location }}</div></section><h2>Résumé</h2><p>{{ summary }}</p><h2>Impact</h2><p>{{ impact }}</p><h2>Chronologie</h2><div class="timeline">{% for item in timeline %}<div class="event"><strong>{{ item.time }}</strong> · {{ item.event }}</div>{% endfor %}</div><h2>Cause racine</h2><p>{{ root_cause }}</p><h2>Actions correctives</h2><table><thead><tr><th>Responsable</th><th>Action</th><th>Échéance</th><th>Statut</th></tr></thead><tbody>{% for item in corrective_actions %}<tr><td>{{ item.owner }}</td><td>{{ item.action }}</td><td>{{ item.due }}</td><td>{{ item.status }}</td></tr>{% endfor %}</tbody></table></body></html>
