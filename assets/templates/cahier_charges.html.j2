<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.cover{background:{{ accent }};color:#fff;padding:28px;margin-bottom:22px}.cover h1{color:#fff;margin:0;font-size:27px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.fact{background:#f5f7fa;border:1px solid #e4e7ec;padding:10px}.fact small{display:block;color:#667085}h2{color:{{ accent }};font-size:15px;border-bottom:2px solid #e4e7ec;padding-bottom:5px}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:#fff;padding:8px;text-align:left}td{padding:8px;border-bottom:1px solid #e4e7ec}.tag{display:inline-block;padding:3px 7px;background:#eef2ff;border-radius:3px}.warning{color:#b42318}
</style></head><body><header class="cover"><h1>CAHIER DES CHARGES</h1><p>{{ project }} · Version {{ version }}</p></header><section class="facts"><div class="fact"><small>Commanditaire</small>{{ sponsor }}</div><div class="fact"><small>Responsable</small>{{ owner }}</div><div class="fact"><small>Date</small>{{ date }}</div></section><h2>1. Contexte</h2><p>{{ context }}</p><h2>2. Objectifs</h2><ul>{% for value in objectives %}<li>{{ value }}</li>{% endfor %}</ul><section class="two"><div><h2>3. Périmètre inclus</h2><ul>{% for value in scope_in %}<li>{{ value }}</li>{% endfor %}</ul></div><div><h2>4. Hors périmètre</h2><ul>{% for value in scope_out %}<li>{{ value }}</li>{% endfor %}</ul></div></section><h2>5. Exigences</h2><table><thead><tr><th>ID</th><th>Priorité</th><th>Exigence</th><th>Critère d'acceptation</th></tr></thead><tbody>{% for req in requirements %}<tr><td>{{ req.id }}</td><td><span class="tag">{{ req.priority }}</span></td><td><strong>{{ req.title }}</strong><br>{{ req.description }}</td><td>{{ req.acceptance }}</td></tr>{% endfor %}</tbody></table><section class="two"><div><h2>6. Livrables</h2><ul>{% for value in deliverables %}<li>{{ value }}</li>{% endfor %}</ul><h2>7. Jalons</h2>{% for item in milestones %}<p><strong>{{ item.date }}</strong> · {{ item.label }}</p>{% endfor %}</div><div><h2>8. Risques</h2>{% for item in risks %}<p class="warning"><strong>{{ item.risk }}</strong><br>{{ item.response }}</p>{% endfor %}</div></section></body></html>
