<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.head{display:flex;justify-content:space-between;border-bottom:4px solid {{ accent }};padding-bottom:14px}.head h1{color:{{ accent }};font-size:24px;margin:0}.control{border-collapse:collapse}.control td{border:1px solid #d0d5dd;padding:6px}.intro{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:20px 0}.panel{background:#f5f7fa;border:1px solid #e4e7ec;padding:12px}h2{font-size:14px;color:{{ accent }};border-bottom:2px solid #e4e7ec;padding-bottom:5px}.roles,.steps{width:100%;border-collapse:collapse}.roles th,.steps th{background:{{ accent }};color:white;padding:8px;text-align:left}.roles td,.steps td{padding:8px;border-bottom:1px solid #e4e7ec}.number{font-size:18px;font-weight:bold;color:{{ accent }}}.footer{margin-top:25px;border-top:1px solid #d0d5dd;padding-top:10px;color:#667085}
</style></head><body><header class="head"><div><h1>PROCÉDURE OPÉRATIONNELLE</h1><p>{{ title }}</p></div><table class="control"><tr><td>Code</td><td><strong>{{ code }}</strong></td></tr><tr><td>Version</td><td>{{ version }}</td></tr><tr><td>Application</td><td>{{ effective_date }}</td></tr></table></header><section class="intro"><div class="panel"><strong>Objectif</strong><p>{{ purpose }}</p></div><div class="panel"><strong>Périmètre</strong><p>{{ scope }}</p></div></section><h2>Responsabilités</h2><table class="roles"><thead><tr><th>Rôle</th><th>Responsabilité</th></tr></thead><tbody>{% for item in roles %}<tr><td>{{ item.role }}</td><td>{{ item.responsibility }}</td></tr>{% endfor %}</tbody></table><h2>Prérequis</h2><ul>{% for item in prerequisites %}<li>{{ item }}</li>{% endfor %}</ul><h2>Déroulement</h2><table class="steps"><thead><tr><th>#</th><th>Étape</th><th>Instruction</th><th>Preuve attendue</th></tr></thead><tbody>{% for item in steps %}<tr><td class="number">{{ item.number }}</td><td><strong>{{ item.title }}</strong></td><td>{{ item.instruction }}</td><td>{{ item.evidence }}</td></tr>{% endfor %}</tbody></table><h2>Contrôles</h2><ul>{% for item in controls %}<li>{{ item }}</li>{% endfor %}</ul><footer class="footer">Propriétaire : {{ owner }} · Enregistrements : {{ records|join(', ') }}</footer></body></html>
