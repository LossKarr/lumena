<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:20mm}body{font-family:Arial,sans-serif;color:#1c2430}.receipt{max-width:650px;margin:20px auto;border:1px solid #d0d5dd;border-top:8px solid {{ accent }};padding:32px}.head{display:flex;justify-content:space-between}.head h1{margin:0;color:{{ accent }};font-size:27px}.amount{text-align:center;background:#f5f7fa;margin:28px 0;padding:22px}.amount strong{display:block;font-size:32px;color:{{ accent }}}dl{display:grid;grid-template-columns:180px 1fr;gap:10px;border-top:1px solid #e4e7ec;padding-top:18px}dt{color:#667085}dd{margin:0;font-weight:600}.footer{margin-top:34px;display:flex;justify-content:space-between;color:#667085;font-size:11px}
</style></head><body><article class="receipt"><header class="head"><div><h1>REÇU DE PAIEMENT</h1><p>N° {{ numero }}</p></div><div style="text-align:right"><strong>{{ emetteur.name }}</strong><br>{{ emetteur.address }}<br>{{ emetteur.city }}</div></header><div class="amount">Montant reçu<strong>{{ '%.2f'|format(montant|float) }} {{ currency }}</strong></div><p>Nous confirmons avoir reçu le règlement de <strong>{{ payeur.name }}</strong>.</p><dl><dt>Date du paiement</dt><dd>{{ date_paiement }}</dd><dt>Mode de règlement</dt><dd>{{ mode }}</dd><dt>Référence</dt><dd>{{ reference }}</dd><dt>Émis le</dt><dd>{{ date }}</dd></dl><footer class="footer"><span>Document généré par {{ emetteur.name }}</span><span>Signature / cachet</span></footer></article></body></html>
