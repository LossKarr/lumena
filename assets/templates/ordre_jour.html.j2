<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:20mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.hero{background:{{ accent }};color:#fff;padding:25px}.hero h1{margin:0;color:#fff;font-size:28px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0}.fact{border-top:3px solid {{ accent }};padding:10px;background:#f5f7fa}.agenda{counter-reset:item}.row{display:grid;grid-template-columns:65px 1fr 100px 80px;gap:10px;padding:13px 8px;border-bottom:1px solid #e4e7ec}.row strong{color:{{ accent }}}.columns{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:25px}.panel{border:1px solid #e4e7ec;padding:14px}.panel h2{font-size:14px;color:{{ accent }};margin-top:0}ul{padding-left:18px}
</style></head><body><header class="hero"><h1>ORDRE DU JOUR</h1><p>{{ reunion }}</p></header><section class="facts"><div class="fact"><strong>Date</strong><br>{{ date_reunion }}</div><div class="fact"><strong>Horaire</strong><br>{{ heure }}</div><div class="fact"><strong>Lieu</strong><br>{{ lieu_reunion }}</div></section><div class="agenda"><div class="row" style="font-weight:bold;background:#f5f7fa"><span>Heure</span><span>Sujet</span><span>Responsable</span><span>Durée</span></div>{% for item in items %}<div class="row"><strong>{{ item.time }}</strong><span>{{ item.topic }}</span><span>{{ item.owner }}</span><span>{{ item.duration }}</span></div>{% endfor %}</div><section class="columns"><div class="panel"><h2>Participants</h2><ul>{% for person in participants %}<li>{{ person }}</li>{% endfor %}</ul></div><div class="panel"><h2>Préparation attendue</h2><ul>{% for task in preparation %}<li>{{ task }}</li>{% endfor %}</ul></div></section><p style="margin-top:25px;color:#667085">Organisé par {{ organisateur }} · Document préparé le {{ date }}</p></body></html>
