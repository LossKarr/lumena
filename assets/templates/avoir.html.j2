<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{display:flex;justify-content:space-between;border-bottom:3px solid {{ accent }};padding-bottom:18px}.head h1{margin:0;color:{{ accent }};font-size:28px}.meta{text-align:right;color:#667085}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:22px 0}.card{background:#f5f7fa;padding:14px;border:1px solid #e4e7ec}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:9px;text-align:left}td{padding:9px;border-bottom:1px solid #e4e7ec}.total{margin:18px 0 0 auto;width:260px;background:#f5f7fa;padding:14px}.notice{margin-top:24px;border-left:3px solid {{ accent }};padding:10px;background:#fff8ef}.sign{margin-top:42px;display:flex;justify-content:space-between}
</style></head><body>
<header class="head"><div><h1>AVOIR</h1><strong>N° {{ numero }}</strong><br>Référence facture : {{ facture_origine }}</div><div class="meta">Émis le {{ date }}<br><strong>{{ issuer.name }}</strong><br>{{ issuer.address }}<br>{{ issuer.city }}</div></header>
<section class="grid"><div class="card"><strong>Émetteur</strong><p>{{ issuer.name }}<br>{{ issuer.address }}<br>{{ issuer.city }}<br>{{ issuer.email }}</p></div><div class="card"><strong>Client</strong><p>{{ client.name }}<br>{{ client.address }}<br>{{ client.city }}<br>{{ client.email }}</p></div></section>
<p class="notice"><strong>Motif :</strong> {{ motif }}</p>
<table><thead><tr><th>Désignation</th><th>Qté</th><th>Montant HT</th><th>TVA</th><th>Total TTC</th></tr></thead><tbody>{% set ns=namespace(total=0) %}{% for item in items %}{% set ht=(item.qty|float)*(item.unit_price|float) %}{% set ttc=ht*(1+(item.vat_rate|float)/100) %}{% set ns.total=ns.total+ttc %}<tr><td>{{ item.description }}</td><td>{{ item.qty }}</td><td>{{ '%.2f'|format(ht) }} {{ currency }}</td><td>{{ item.vat_rate }} %</td><td>{{ '%.2f'|format(ttc) }} {{ currency }}</td></tr>{% endfor %}</tbody></table>
<div class="total"><strong>Montant crédité</strong><br><span style="font-size:22px;color:{{ accent }}">{{ '%.2f'|format(ns.total) }} {{ currency }}</span></div><div class="sign"><span>Validation émetteur</span><span>Accusé de réception client</span></div>
</body></html>
