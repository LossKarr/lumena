<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{display:flex;justify-content:space-between}.head h1{font-size:27px;color:{{ accent }};margin:0}.badge{display:inline-block;background:{{ accent }};color:white;padding:5px 10px;margin-top:8px}.party{display:flex;gap:16px;margin:25px 0}.party>div{flex:1;background:#f5f7fa;border:1px solid #e4e7ec;padding:14px}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:9px;text-align:left}td{padding:10px;border-bottom:1px solid #e4e7ec}.summary{width:290px;margin:18px 0 0 auto}.summary td:last-child{text-align:right}.grand{background:#1c2430;color:white;font-weight:bold}.terms{margin-top:28px;border-top:1px solid #d0d5dd;padding-top:14px}
</style></head><body>
<header class="head"><div><h1>FACTURE PROFORMA</h1><span class="badge">Document non fiscal</span><p>N° {{ numero }} · {{ date }}</p></div><div style="text-align:right"><strong>{{ issuer.name }}</strong><br>{{ issuer.address }}<br>{{ issuer.city }}<br>{{ issuer.email }}</div></header>
<section class="party"><div><strong>FOURNISSEUR</strong><p>{{ issuer.name }}<br>{{ issuer.address }}<br>{{ issuer.city }}</p></div><div><strong>DESTINATAIRE</strong><p>{{ client.name }}<br>{{ client.address }}<br>{{ client.city }}<br>{{ client.email }}</p></div></section>
<table><thead><tr><th>Description</th><th>Qté</th><th>Unité</th><th>Prix unitaire</th><th>Total</th></tr></thead><tbody>{% set ns=namespace(total=0) %}{% for item in items %}{% set line=(item.qty|float)*(item.unit_price|float) %}{% set ns.total=ns.total+line %}<tr><td>{{ item.description }}</td><td>{{ item.qty }}</td><td>{{ item.unit|default('unité') }}</td><td>{{ '%.2f'|format(item.unit_price|float) }} {{ currency }}</td><td>{{ '%.2f'|format(line) }} {{ currency }}</td></tr>{% endfor %}</tbody></table>
<table class="summary"><tr class="grand"><td>TOTAL ESTIMATIF</td><td>{{ '%.2f'|format(ns.total) }} {{ currency }}</td></tr></table><section class="terms"><strong>Validité :</strong> {{ validity_days }} jours · <strong>Conditions de livraison :</strong> {{ incoterm }}<p>Cette proforma est fournie à titre informatif et ne constitue pas une facture fiscale.</p></section>
</body></html>
