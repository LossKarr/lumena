<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{display:flex;justify-content:space-between;border-bottom:3px solid {{ accent }};padding-bottom:16px}.head h1{margin:0;color:{{ accent }};font-size:27px}.client{background:#f5f7fa;padding:14px;margin:20px 0;width:48%}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:9px;text-align:left}td{padding:9px;border-bottom:1px solid #e4e7ec}.money{text-align:right}.balance{margin:20px 0 0 auto;width:280px;background:#1c2430;color:white;padding:16px;font-size:16px;display:flex;justify-content:space-between}.note{margin-top:30px;color:#667085;border-top:1px solid #d0d5dd;padding-top:12px}
</style></head><body><header class="head"><div><h1>RELEVÉ CLIENT</h1><p>N° {{ numero }} · {{ periode }}</p></div><div style="text-align:right"><strong>{{ issuer.name }}</strong><br>{{ issuer.address }}<br>{{ issuer.city }}</div></header><section class="client"><strong>COMPTE CLIENT</strong><p>{{ client.name }}<br>{{ client.address }}<br>{{ client.city }}<br>{{ client.email }}</p></section><table><thead><tr><th>Date</th><th>Référence</th><th>Description</th><th>Débit</th><th>Crédit</th><th>Solde</th></tr></thead><tbody>{% set ns=namespace(balance=opening_balance|float) %}<tr><td colspan="5"><strong>Solde d'ouverture</strong></td><td class="money">{{ '%.2f'|format(ns.balance) }} {{ currency }}</td></tr>{% for tx in transactions %}{% set ns.balance=ns.balance+(tx.debit|float)-(tx.credit|float) %}<tr><td>{{ tx.date }}</td><td>{{ tx.reference }}</td><td>{{ tx.description }}</td><td class="money">{{ '%.2f'|format(tx.debit|float) }}</td><td class="money">{{ '%.2f'|format(tx.credit|float) }}</td><td class="money">{{ '%.2f'|format(ns.balance) }}</td></tr>{% endfor %}</tbody></table><div class="balance"><span>SOLDE À DATE</span><strong>{{ '%.2f'|format(ns.balance) }} {{ currency }}</strong></div><p class="note">Merci de signaler toute divergence en rappelant le numéro du relevé.</p></body></html>
