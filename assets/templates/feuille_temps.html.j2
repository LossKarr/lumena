<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4 landscape;margin:14mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10px}.head{display:flex;justify-content:space-between;align-items:end}.head h1{color:{{ accent }};font-size:26px;margin:0}.employee{display:flex;gap:30px;background:#f5f7fa;border:1px solid #e4e7ec;padding:12px;margin:16px 0}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;text-align:left;padding:8px}td{padding:9px;border-bottom:1px solid #e4e7ec}.hours{text-align:right}.total{background:#1c2430;color:white;font-weight:bold}.sign{display:flex;justify-content:space-between;margin-top:30px}.sign div{width:42%;border-top:1px solid #667085;padding-top:8px}
</style></head><body><header class="head"><div><h1>{{ titre|default('FEUILLE DE TEMPS', true) }}</h1>{% if numero is defined and numero %}<p>N° {{ numero }}</p>{% endif %}<p>{{ periode }}</p></div><span>Éditée le {{ date }}</span></header><section class="employee"><span><strong>{{ collaborateur.name }}</strong></span><span>Matricule : {{ collaborateur.matricule }}</span><span>Service : {{ collaborateur.service }}</span></section><table><thead><tr><th>Date</th><th>Projet / centre de coût</th><th>Activité</th><th>Heures</th></tr></thead><tbody>{% set ns=namespace(total=0) %}{% for entry in entries %}{% set ns.total=ns.total+(entry.hours|float) %}<tr><td>{{ entry.date }}</td><td>{{ entry.project }}</td><td>{{ entry.activity }}</td><td class="hours">{{ '%.2f'|format(entry.hours|float) }}</td></tr>{% endfor %}<tr class="total"><td colspan="3">TOTAL SAISI / ATTENDU</td><td class="hours">{{ '%.2f'|format(ns.total) }} h / {{ expected_hours }} h</td></tr></tbody></table><section class="sign"><div>Validation collaborateur</div><div>Validation manager</div></section></body></html>
