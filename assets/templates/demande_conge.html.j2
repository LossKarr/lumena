<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:20mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{border-bottom:4px solid {{ accent }};padding-bottom:14px}.head h1{color:{{ accent }};font-size:26px;margin:0}.employee{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0}.field{background:#f5f7fa;border:1px solid #e4e7ec;padding:12px}.field span{display:block;color:#667085;font-size:9px;text-transform:uppercase;margin-bottom:5px}.period{display:grid;grid-template-columns:1fr 1fr 100px;gap:12px;margin:15px 0}.comment{border:1px solid #d0d5dd;min-height:70px;padding:12px}.approval{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:32px}.box{height:100px;border:1px solid #d0d5dd;padding:12px}.choice{margin-top:18px;font-size:15px}
</style></head><body><header class="head"><h1>DEMANDE DE CONGÉ</h1><p>Soumise le {{ date }}</p></header><section class="employee"><div class="field"><span>Collaborateur</span><strong>{{ collaborateur.name }}</strong></div><div class="field"><span>Matricule</span>{{ collaborateur.matricule }}</div><div class="field"><span>Service</span>{{ collaborateur.service }}</div></section><div class="field"><span>Type de congé</span><strong>{{ type_conge }}</strong></div><section class="period"><div class="field"><span>Du</span>{{ date_debut }}</div><div class="field"><span>Au</span>{{ date_fin }}</div><div class="field"><span>Jours</span><strong>{{ jours }}</strong></div></section><div class="field"><span>Relais pendant l'absence</span>{{ relais }}</div><h2>Commentaire et passation</h2><div class="comment">{{ commentaire }}</div><section class="approval"><div class="box"><strong>Demandeur</strong><br><br>Date et signature</div><div class="box"><strong>Décision manager</strong><div class="choice">☐ Approuvée &nbsp;&nbsp; ☐ Refusée</div><br>Date et signature</div></section></body></html>
