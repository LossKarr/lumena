<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:11px}.head{border-left:7px solid {{ accent }};padding-left:16px}.head h1{margin:0;color:{{ accent }};font-size:27px}.route{display:grid;grid-template-columns:1fr 50px 1fr;align-items:center;gap:12px;margin:25px 0}.party{background:#f5f7fa;border:1px solid #e4e7ec;padding:14px}.arrow{text-align:center;font-size:25px;color:{{ accent }}}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;padding:9px;text-align:left}td{padding:10px;border-bottom:1px solid #e4e7ec}.meta{display:flex;gap:14px;margin:18px 0}.meta div{flex:1;border-top:2px solid {{ accent }};padding-top:8px}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:50px;margin-top:42px}.signature{height:90px;border:1px solid #d0d5dd;padding:10px}
</style></head><body>
<header class="head"><h1>BON DE LIVRAISON</h1><p><strong>N° {{ numero }}</strong> · Commande {{ commande_ref }} · {{ date }}</p></header>
<section class="route"><div class="party"><strong>EXPÉDITEUR</strong><p>{{ expediteur.name }}<br>{{ expediteur.address }}<br>{{ expediteur.city }}</p></div><div class="arrow">→</div><div class="party"><strong>DESTINATAIRE</strong><p>{{ destinataire.name }}<br>{{ destinataire.address }}<br>{{ destinataire.city }}</p></div></section>
<div class="meta"><div><strong>Transporteur</strong><br>{{ transporteur }}</div><div><strong>Date de livraison</strong><br>{{ date }}</div></div>
<table><thead><tr><th>Référence</th><th>Désignation</th><th>Commandé</th><th>Livré</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.ref }}</td><td>{{ item.description }}</td><td>{{ item.qty_commandee }}</td><td>{{ item.qty_livree }}</td></tr>{% endfor %}</tbody></table>
<p><strong>Réserves :</strong> {{ reservations }}</p><section class="signatures"><div class="signature"><strong>Expéditeur</strong><br><br>Nom, date et signature</div><div class="signature"><strong>Réceptionnaire</strong><br><br>Nom, date et signature</div></section>
</body></html>
