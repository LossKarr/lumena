<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#1c2430;font-size:10.5px}.cover{background:{{ accent }};color:white;padding:24px}.cover h1{color:white;margin:0;font-size:25px}.identity{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}.field{background:#f5f7fa;border:1px solid #e4e7ec;padding:11px}.field small{display:block;color:#667085;text-transform:uppercase}h2{color:{{ accent }};font-size:15px;border-bottom:2px solid #e4e7ec;padding-bottom:5px}table{width:100%;border-collapse:collapse}th{background:{{ accent }};color:white;text-align:left;padding:8px}td{padding:8px;border-bottom:1px solid #e4e7ec}.rating{letter-spacing:2px;color:{{ accent }}}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}.sign{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:30px}.sign div{height:70px;border:1px solid #d0d5dd;padding:9px}
</style></head><body><header class="cover"><h1>COMPTE RENDU D'ENTRETIEN ANNUEL</h1><p>Période {{ periode }}</p></header><section class="identity"><div class="field"><small>Collaborateur</small><strong>{{ collaborateur.name }}</strong></div><div class="field"><small>Poste</small>{{ collaborateur.poste }}</div><div class="field"><small>Manager</small>{{ manager }}</div></section><h2>Bilan de la période</h2><p>{{ bilan }}</p><h2>Objectifs évalués</h2><table><thead><tr><th>Objectif</th><th>Statut</th><th>Commentaire</th></tr></thead><tbody>{% for objective in objectives %}<tr><td>{{ objective.label }}</td><td>{{ objective.status }}</td><td>{{ objective.comment }}</td></tr>{% endfor %}</tbody></table><h2>Compétences</h2><table><tbody>{% for skill in skills %}<tr><td>{{ skill.label }}</td><td class="rating">{% for dot in range(skill.rating) %}●{% endfor %}{% for dot in range(5-skill.rating) %}○{% endfor %}</td></tr>{% endfor %}</tbody></table><section class="two"><div><h2>Prochains objectifs</h2><ul>{% for item in next_objectives %}<li>{{ item }}</li>{% endfor %}</ul></div><div><h2>Développement / formation</h2><ul>{% for item in training %}<li>{{ item }}</li>{% endfor %}</ul></div></section><section class="sign"><div>Collaborateur · date et signature</div><div>Manager · date et signature</div></section></body></html>
