# Auto-generated from web.routes.config._CONFIG_SCHEMA + extras
# Do not edit manually; run: .\venv\Scripts\python.exe scripts\sync_env_example.py

# === Alertes ===
# Alertes critiques
# Active le système d'alertes critiques (disk full, provider down, daemon crash). Via Twilio si configuré.
# Type: bool | Niveau: simple
LUMENA_CRITICAL_ALERTS_ENABLED=1

# SMS critiques
# Envoie les alertes critiques par SMS via Twilio. Nécessite TWILIO_ACCOUNT_SID et AUTH_TOKEN.
# Type: bool | Niveau: avancé
LUMENA_CRITICAL_SMS_ENABLED=1

# Appels critiques
# Appelle le numéro d'alerte en cas d'incident critique. Dernier recours après SMS.
# Type: bool | Niveau: avancé
LUMENA_CRITICAL_CALL_ENABLED=1

# Cooldown alertes (sec)
# Délai minimum entre deux alertes du même type. 300s = 5 minutes. Empêche le spam d'alertes.
# Type: number | Niveau: avancé
LUMENA_CRITICAL_ALERT_COOLDOWN_SEC=300

# Numéro alerte
# Numéro de téléphone destination des alertes SMS/appel. Format international : +33612345678
# Type: text | Niveau: avancé
LUMENA_ALERT_TO_NUMBER=

# === Apprentissage ===
# Apprentissage d'identité
# Lumena extrait et mémorise automatiquement les faits personnels (prénom, métier, ville…) au fil des conversations.
# Type: bool | Niveau: simple
LUMENA_IDENTITY_LEARNING=1

# Cooldown questions identité (sec)
# Délai minimum entre deux demandes d'infos manquantes (en secondes). 300 = 5 min.
# Type: number | Niveau: expert
LUMENA_IDENTITY_HINT_COOLDOWN=300

# Souvenirs injectés par requête
# Nombre maximum de souvenirs ChromaDB injectés dans le prompt à chaque échange. Plus = plus de contexte, mais plus de tokens consommés.
# Type: number | Niveau: avancé
LUMENA_MEMORY_MAX_INJECT=20

# === Automation (n8n) ===
# n8n URL
# URL de l'instance n8n. Par défaut http://localhost:5678 si lancé en Docker local.
# Type: text | Niveau: simple
N8N_BASE_URL=http://localhost:5678

# n8n API Key
# Clé API n8n. Générer dans n8n > Settings > API > Create API Key. Requise pour piloter les workflows.
# Type: secret | Niveau: simple
N8N_API_KEY=

# Auto-start n8n (Docker)
# 1 = Lumena démarre automatiquement n8n via Docker au boot. 0 = désactivé.
# Type: text | Niveau: simple
N8N_AUTO_START=1

# === Autonomie ===
# Exécution autonome
# Active l'exécution réelle des actions autonomes (daemon). Désactiver = mode observation seule.
# Type: bool | Niveau: simple
LUMENA_AUTONOMY_EXECUTE_ACTIONS=1

# Mode progressif
# Limite les actions autonomes à la liste autorisée + budget horaire. Recommandé en production.
# Type: bool | Niveau: simple
LUMENA_AUTONOMY_PROGRESSIVE_MODE=1

# Actions autorisées
# Liste des types d'actions que le daemon peut exécuter en mode progressif. Séparées par des virgules.
# Type: text | Niveau: simple
LUMENA_AUTONOMY_ALLOWED_ACTIONS=EXPLORE_WEB,LEARN_SOMETHING,REFLECT,WRITE_DIARY,CHECK_NEWS

# Budget actions/heure
# Nombre max d'actions autonomes par heure glissante. Protège contre l'emballement du daemon.
# Type: number | Niveau: simple
LUMENA_AUTONOMY_MAX_ACTIONS_PER_HOUR=12

# Timeout action (sec)
# Durée max d'une action autonome individuelle. 180s = 3 minutes.
# Type: number | Niveau: avancé
LUMENA_AUTONOMY_ACTION_TIMEOUT_SEC=180

# Disque libre min (Go)
# Sous ce seuil, le daemon bloque les actions autonomes lourdes et privilegie diagnostic/rapport/reflexion.
# Type: number | Niveau: avancé
LUMENA_AUTONOMY_MIN_FREE_GB=10

# Cooldown objectif (sec)
# Délai minimum entre deux exécutions du même objectif. Empêche la répétition en boucle.
# Type: number | Niveau: avancé
LUMENA_AUTONOMY_GOAL_COOLDOWN_SEC=60

# Max échecs objectif
# Nombre d'échecs consécutifs avant de mettre en pause un objectif. Protège contre les boucles d'erreur.
# Type: number | Niveau: avancé
LUMENA_AUTONOMY_GOAL_MAX_FAILURES=5

# === Browser ===
# Browser headless
# 1 = navigateur invisible (recommandé). 0 = afficher la fenêtre (debug).
# Type: bool | Niveau: avancé
# Redémarrage requis après modification
LUMENA_BROWSER_HEADLESS=1

# Locale navigateur
# Locale du navigateur Playwright (ex: fr_FR, en_US). Influence la langue des sites visités.
# Type: text | Niveau: avancé
LUMENA_BROWSER_LOCALE=fr_FR

# Max onglets simultanés
# Nombre maximum d'onglets Playwright ouverts en parallèle. 5 par défaut.
# Type: number | Niveau: avancé
LUMENA_BROWSER_MAX_TABS=5

# === Cerveaux Spécialisés ===
# Cerveau Vision (analyse images)
# auto = meilleur modèle disponible avec support vision (OpenAI/Anthropic/Google/Grok/Z.AI)
# Type: select | Niveau: simple
# Options: auto, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.4-nano, gpt-4o, gpt-4o-mini, o3, o4-mini, claude-fable-5, claude-mythos-5, claude-opus-4.8, claude-opus-4.7, claude-opus-4.6, claude-sonnet-4.6, claude-sonnet-4.5, claude-haiku-4.5, gemini-3.1-pro, gemini-2.5-pro, gemini-2.5-flash, grok-4.3, grok-4.20-0309-reasoning, grok-4.20-0309-non-reasoning, grok-4-1-fast-reasoning, kimi-k2.7-code, kimi-k2.6, nvidia-step-3.7-flash, nvidia-kimi-k2.6, nvidia-minimax-m3, nvidia-gemma-4-31b-it, glm-4.6v-flash, glm-5v-turbo
LUMENA_BRAIN_VISION=auto

# Cerveau Code (analyse et génération)
# auto = meilleur modèle code disponible (score HumanEval/SWE-bench)
# Type: select | Niveau: simple
# Options: auto, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4o, gpt-4o-mini, o3, o4-mini, claude-fable-5, claude-mythos-5, claude-opus-4.8, claude-opus-4.7, claude-opus-4.6, claude-sonnet-4.6, grok-4.3, deepseek-v3, deepseek-reasoner, gemini-3.1-pro, gemini-2.5-pro, kimi-k2.7-code, kimi-k2.6, nvidia-deepseek-v4-pro, nvidia-deepseek-v4-flash, nvidia-gpt-oss-120b, nvidia-step-3.7-flash, nvidia-kimi-k2.6, nvidia-glm-5.1, nvidia-nemotron-3-ultra-550b-a55b, nvidia-minimax-m3, nvidia-minimax-m2.7, nvidia-gemma-4-31b-it, minimax-m3, minimax-m2.5, minimax-m2.7, grok-4.20-0309-reasoning, grok-4.20-multi-agent-0309, glm-5.1, glm-4.7-flashx, glm-4.7-flash
LUMENA_BRAIN_CODE=auto

# Cerveau Web (recherche et analyse web)
# auto = meilleur modèle disponible pour la recherche et analyse web
# Type: select | Niveau: simple
# Options: auto, gpt-5.5, gpt-5.4, gemini-3.1-pro, gemini-2.5-pro, gemini-2.5-flash, claude-fable-5, claude-opus-4.8, claude-sonnet-4.6, claude-opus-4.7, claude-opus-4.6, gpt-4o-mini, grok-4.3, grok-4.20-0309-reasoning, grok-4.20-multi-agent-0309, kimi-k2.7-code, kimi-k2.6, kimi-k2.5, deepseek-v3, minimax-m3, minimax-m2.5, nvidia-deepseek-v4-pro, nvidia-gpt-oss-120b, nvidia-step-3.7-flash, nvidia-glm-5.1, nvidia-minimax-m3, nvidia-gemma-4-31b-it, nvidia-nemotron-3-ultra-550b-a55b, glm-5.1, glm-4.7-flashx
LUMENA_BRAIN_WEB=auto

# Modèle génération d'images
# auto = cascade local/gratuit → cheap → premium selon les clés disponibles. Modèles : Gemini, GPT-image, FLUX, Stable Diffusion, Imagen, Ideogram, Recraft, MiniMax, Replicate, HuggingFace.
# Type: select | Niveau: simple
# Options: auto, gemini-3.1-flash-image, gemini-3-pro-image, gemini-2.5-flash-image, huggingface-sdxl, gpt-image-2, gpt-image-1.5, gpt-image-1-mini, flux-2-max, flux-2-pro, flux-2-flex, flux-2-klein-4b, flux-2-klein-9b, flux-schnell, flux-kontext-pro, flux-kontext-max, flux-1.1-pro-ultra, stable-image-ultra, stable-image-core, sd3.5-large, sd3.5-large-turbo, sd3.5-medium, sd3.5-flash, imagen-4-ultra, imagen-4, imagen-4-fast, ideogram-v4-quality, ideogram-v4, ideogram-v4-turbo, ideogram-v3-quality, ideogram-v3-balanced, ideogram-v3-turbo, recraft-v4, recraft-v4-svg, grok-imagine-image, grok-imagine-image-quality, grok-imagine-image-pro, minimax-image-01, seedream-5-lite, seedream-4.5, wan-2.7-image-pro, qwen-image, hunyuan-image-3
LUMENA_BRAIN_IMAGE_GEN=auto

# Taille d'image par défaut
# Résolution par défaut des images générées. Plus grand = plus lent et plus cher.
# Type: select | Niveau: avancé
# Options: 1024x1024, 1536x1024, 1024x1536, 1792x1024, 1024x1792, 2048x2048
LUMENA_IMAGE_DEFAULT_SIZE=1024x1024

# Qualité d'image par défaut
# standard = rapide et pas cher. hd = meilleure qualité, plus de détails.
# Type: select | Niveau: avancé
# Options: standard, hd
LUMENA_IMAGE_DEFAULT_QUALITY=hd

# === Clés API ===
# OpenAI API Key
# Clé API OpenAI (sk-...). Utilisée pour GPT-5.4, GPT-4o, DALL-E 3. Obtenir sur platform.openai.com
# Type: secret | Niveau: simple
OPENAI_API_KEY=

# Anthropic API Key
# Clé API Anthropic (sk-ant-...). Utilisée pour Claude Opus/Sonnet/Haiku. Obtenir sur console.anthropic.com
# Type: secret | Niveau: simple
ANTHROPIC_API_KEY=

# Google API Key
# Clé API Google AI (AIza...). Utilisée pour Gemini Pro/Flash. Obtenir sur aistudio.google.com
# Type: secret | Niveau: simple
GOOGLE_API_KEY=

# DeepSeek API Key
# Clé API DeepSeek (sk-...). Modèle principal par défaut. ~0.27$/M tokens. Obtenir sur platform.deepseek.com
# Type: secret | Niveau: simple
DEEPSEEK_API_KEY=

# Moonshot (Kimi) API Key
# Clé API Moonshot/Kimi pour Kimi K2.7 Code et K2.6. Obtenir sur platform.kimi.ai
# Type: secret | Niveau: simple
MOONSHOT_API_KEY=

# xAI (Grok) API Key
# Clé API xAI pour les modèles Grok. Obtenir sur console.x.ai
# Type: secret | Niveau: simple
XAI_API_KEY=

# NVIDIA NIM API Key
# Clé API NVIDIA NIM. Accès aux fallbacks gratuits GPT-OSS, Nemotron, Kimi K2.6, DeepSeek V4, GLM, Step et MiniMax. Obtenir sur build.nvidia.com
# Type: secret | Niveau: simple
NVIDIA_API_KEY=

# MiniMax API Key
# Clé API MiniMax. Accès aux modèles M3/M2.7/M2.5/M2.1 natifs. Obtenir sur platform.minimax.io
# Type: secret | Niveau: simple
MINIMAX_API_KEY=

# Z.AI API Key
# Clé API Z.AI pour GLM-5.1, GLM-4.7-Flash, CogView-4... Obtenir sur z.ai
# Type: secret | Niveau: avancé
ZAI_API_KEY=

# Z.AI Base URL
# URL de base API Z.AI. Modifier uniquement si proxy custom.
# Type: text | Niveau: avancé
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Mistral AI API Key
# Clé API Mistral pour Mistral Large, Codestral, Devstral, Magistral, Ministral. Obtenir sur console.mistral.ai
# Type: secret | Niveau: simple
MISTRAL_API_KEY=

# Stability AI API Key
# Clé API Stability AI. Utilisée pour Stable Diffusion 3.5, Stable Image Ultra/Core. Obtenir sur platform.stability.ai
# Type: secret | Niveau: avancé
STABILITY_API_KEY=

# FLUX (BFL) API Key
# Clé API Black Forest Labs (FLUX). Utilisée pour FLUX.1 Pro/Dev/Schnell, Kontext. Obtenir sur api.bfl.ml
# Type: secret | Niveau: avancé
BFL_API_KEY=

# Ideogram API Key
# Clé API Ideogram. Excellente typographie dans les images. Obtenir sur ideogram.ai/api
# Type: secret | Niveau: avancé
IDEOGRAM_API_KEY=

# Recraft API Key
# Clé API Recraft V4. Génération de vecteurs et images de qualité pro. Obtenir sur recraft.ai
# Type: secret | Niveau: avancé
RECRAFT_API_KEY=

# Replicate API Token
# Token API Replicate. Accès à des centaines de modèles image open-source. Obtenir sur replicate.com/account/api-tokens
# Type: secret | Niveau: avancé
REPLICATE_API_TOKEN=

# HuggingFace Token
# Token HuggingFace (hf_...). Accès aux modèles Inference API (SDXL, etc.). Obtenir sur huggingface.co/settings/tokens
# Type: secret | Niveau: avancé
HUGGINGFACE_TOKEN=

# Telegram Bot Token
# Token du bot Telegram Lumena. Créer via @BotFather sur Telegram.
# Type: secret | Niveau: simple
TELEGRAM_TOKEN=

# Discord Bot Token
# Token du bot Discord Lumena. Créer sur discord.com/developers/applications
# Type: secret | Niveau: simple
DISCORD_TOKEN=

# GitHub Token
# Personal Access Token GitHub. Permet à Lumena de créer des repos, commits, PRs. Obtenir dans Settings > Developer settings.
# Type: secret | Niveau: simple
GITHUB_TOKEN=

# Twilio Account SID
# SID du compte Twilio (AC...). Requis pour les alertes SMS/appel. Visible sur console.twilio.com
# Type: secret | Niveau: simple
TWILIO_ACCOUNT_SID=

# Twilio Auth Token
# Token d'authentification Twilio. Paire avec ACCOUNT_SID pour les SMS/appels.
# Type: secret | Niveau: simple
TWILIO_AUTH_TOKEN=

# Spotify Client ID
# Client ID de l'app Spotify. Permet de contrôler la lecture musicale. Créer sur developer.spotify.com
# Type: secret | Niveau: simple
SPOTIFY_CLIENT_ID=

# Spotify Client Secret
# Client Secret de l'app Spotify. Paire avec le Client ID.
# Type: secret | Niveau: simple
SPOTIFY_CLIENT_SECRET=

# Notion Integration Token
# Token d'intégration Notion (ntn_...). Permet lecture/écriture des pages Notion. Créer sur notion.so/my-integrations
# Type: secret | Niveau: simple
NOTION_API_KEY=

# Brave Search API Key
# Clé API Brave Search. Moteur de recherche alternatif à DuckDuckGo. Obtenir sur brave.com/search/api
# Type: secret | Niveau: simple
BRAVE_SEARCH_API_KEY=

# Twilio From Number
# Numéro Twilio source des SMS/appels. Format international : +1234567890. Visible sur console.twilio.com
# Type: text | Niveau: avancé
TWILIO_FROM_NUMBER=

# Discord Main Channel ID
# ID du salon Discord principal où Lumena poste les messages. Clic droit sur le salon > Copier l'identifiant.
# Type: text | Niveau: avancé
DISCORD_MAIN_CHANNEL_ID=

# === Computer Use ===
# Mode d'exécution CU
# cloud = providers cloud prioritaires, hybrid = cloud + local en fallback, local = sans providers cloud (LLM local Ollama + OCR uniquement, navigation web toujours possible).
# Type: select | Niveau: avancé
# Options: cloud, hybrid, local
LUMENA_EXECUTION_MODE=hybrid

# Ordre vision CU
# Override de la policy vision (ex: anthropic,google,openai). Vide = policy défaut selon le mode.
# Type: text | Niveau: avancé
LUMENA_CU_VISION_ORDER=

# Vision Ollama en mode cloud/hybrid
# Ajoute Ollama en queue de la cascade vision même en mode cloud ou hybrid. Toujours actif en local.
# Type: bool | Niveau: avancé
LUMENA_CU_OLLAMA_VISION=0

# Max itérations agent CU
# Nombre maximum de tours de boucle pour l'agent Computer Use autonome.
# Type: number | Niveau: avancé
LUMENA_CU_MAX_ITERATIONS=30

# Timeout agent CU (secondes)
# Timeout global de l'agent Computer Use en secondes (600 = 10 min).
# Type: number | Niveau: avancé
LUMENA_CU_TIMEOUT_SEC=600

# === Email ===
# Adresse email de Lumena
# Adresse Gmail utilisée par Lumena pour envoyer et lire des emails. Ex : lumena.ia@gmail.com
# Type: text | Niveau: simple
LUMENA_EMAIL=

# Mot de passe / App Password
# App Password Gmail (16 caractères sans espaces). Générer dans Google Account > Sécurité > Mots de passe d'application.
# Type: secret | Niveau: simple
LUMENA_EMAIL_PASSWORD=

# Ton adresse email principale
# Ton email personnel. Lumena l'utilise pour t'envoyer des rapports et notifications.
# Type: text | Niveau: simple
LUMENA_USER_EMAIL=

# === Fine-tuning ===
# Modèle LLM du judge
# Modèle LLM utilisé pour scorer la qualité des conversations avant fine-tuning. deepseek-chat est le plus rapide et économique.
# Type: select | Niveau: avancé
# Options: qwen3-8b, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4o, gpt-5.4-nano, gpt-4o-mini, gpt-4.1, o3, o4-mini, gpt-5.3-codex, claude-opus-4.8, claude-fable-5, claude-mythos-5, claude-opus-4.7, claude-opus-4.6, claude-opus-4.5, claude-sonnet-4.6, claude-sonnet-4.5, claude-haiku-4.5, gemini-3.5-flash, gemini-3.1-pro, gemini-2.5-flash, gemini-2.5-pro, kimi-k2.7-code, kimi-k2.5, kimi-k2.6, kimi-k2-0905-preview, kimi-k2-turbo-preview, kimi-k2-thinking, kimi-k2-thinking-turbo, grok-4.3, grok-4-1-fast-reasoning, grok-4-1-fast-non-reasoning, grok-4.20-0309-reasoning, grok-4.20-0309-non-reasoning, grok-4.20-multi-agent-0309, nvidia-deepseek-v4-flash, nvidia-deepseek-v4-pro, nvidia-gpt-oss-120b, nvidia-step-3.7-flash, nvidia-kimi-k2.6, nvidia-glm-5.1, nvidia-nemotron-3-ultra-550b-a55b, nvidia-minimax-m2.7, nvidia-minimax-m3, nvidia-gemma-4-31b-it, minimax-m3, minimax-m2.5, minimax-m2.5-highspeed, minimax-m2.1, minimax-m2.1-highspeed, minimax-m2.7, glm-5.1, glm-4.7-flashx, glm-4.7-flash, glm-4.5-flash, glm-4.6v-flash, glm-5v-turbo, mistral-large, codestral, devstral, mistral-small, magistral-medium, ministral-8b, deepseek-v4-flash, deepseek-v4-pro, deepseek-v3, deepseek-reasoner
LUMENA_JUDGE_MODEL=deepseek-chat

# Seuil de validation judge
# Score minimum (0-10) pour qu'une conversation entre dans le dataset d'entraînement. 6.5 par défaut. Augmenter pour plus de sélectivité.
# Type: number | Niveau: avancé
LUMENA_JUDGE_THRESHOLD=6.5

# Scoring automatique activé
# Active le scoring LLM (5_judge.py) automatiquement avant chaque fine-tuning. Désactiver si pas de clé DeepSeek.
# Type: bool | Niveau: avancé
LUMENA_FINETUNING_AUTO_JUDGE=1

# Données personnalité activées
# Génère automatiquement les données d'identité/personnalité Lumena (1_prepare_data.py) avant chaque fine-tuning.
# Type: bool | Niveau: avancé
LUMENA_FINETUNING_AUTO_PREPARE=1

# Rejection sampling activé
# Lance le rejection sampling DPO (6_rejection_sampling.py) avant chaque fine-tuning. Génère des paires préférences.
# Type: bool | Niveau: avancé
LUMENA_FINETUNING_AUTO_SAMPLING=1

# Min exemples pour fine-tuning
# Nombre minimum de conversations validées requises pour lancer un fine-tuning. Évite l'entraînement sur trop peu de données.
# Type: number | Niveau: avancé
LUMENA_RETRAIN_MIN_EXAMPLES=20

# === IONOS (Hébergement) ===
# ReAct : propositions DELETE BDD IONOS
# Kill-switch GLOBAL (4.5B). 0 = l'assistant ne peut PAS proposer de suppression de lignes BDD (recommandé). 1 = autorise UNIQUEMENT la création de propositions DELETE (jamais l'exécution, qui reste manuelle via le panel). Cumulatif avec les flags par site (delete_enabled + allowlist).
# Type: bool | Niveau: avancé
LUMENA_IONOS_REACT_DELETE_ENABLED=0

# Auto-création tables sandbox IONOS
# 0 = si la sandbox BDD d'un site est désactivée, Lumena demande d'abord l'activation. 1 = pour une demande explicite de création de table sandbox/test, Lumena peut activer temporairement la sandbox, créer la table via le bridge sécurisé, puis restaurer l'état précédent.
# Type: bool | Niveau: avancé
LUMENA_IONOS_AUTO_SANDBOX_CREATE_ENABLED=0

# ReAct : propositions DROP table sandbox
# Kill-switch GLOBAL (4.6). 0 = l'assistant ne peut PAS proposer de DROP de table sandbox (recommandé). 1 = autorise UNIQUEMENT la création de propositions DROP sur tables lumena_sandbox_* VIDES (jamais l'exécution, manuelle via le panel avec nom à retaper). Cumulatif avec le flag par site sandbox_drop_enabled.
# Type: bool | Niveau: avancé
LUMENA_IONOS_SANDBOX_DROP_ENABLED=0

# Site IONOS par défaut
# Domaine par défaut pour les déploiements (ex: lumena.fr). Vide = demander à chaque fois.
# Type: text | Niveau: avancé
LUMENA_IONOS_DEFAULT_SITE=

# Backup avant déploiement
# Télécharge les fichiers existants en backup local avant chaque déploiement.
# Type: bool | Niveau: avancé
LUMENA_IONOS_BACKUP_BEFORE_DEPLOY=1

# Taille max upload (Mo)
# Taille maximale totale d'un déploiement en Mo. Protège contre les uploads accidentels.
# Type: number | Niveau: avancé
LUMENA_IONOS_MAX_UPLOAD_MB=100

# === Instance ===
# Instance ID
# Identifiant unique de cette instance Lumena. Auto-généré si vide. Utile pour distinguer plusieurs instances.
# Type: text | Niveau: expert
LUMENA_INSTANCE_ID=

# Nom de l'instance
# Nom affiché pour cette instance (ex: Lumena-Pro, Lumena-Home). Utilisé dans les logs et le panel.
# Type: text | Niveau: avancé
LUMENA_INSTANCE_NAME=Lumena

# Dossier data
# Chemin absolu ou relatif du dossier data. Utile pour isoler plusieurs instances. Nécessite un redémarrage.
# Type: text | Niveau: expert
# Redémarrage requis après modification
LUMENA_DATA_DIR=./data

# Dossier workspace
# Dossier où Lumena crée les projets. Nécessite un redémarrage.
# Type: text | Niveau: expert
# Redémarrage requis après modification
LUMENA_WORKSPACE_DIR=./workspace

# URL publique de l'instance
# URL publique complète (ex: http://localhost:8080). Auto-dérivée de LUMENA_PORT si vide. Utile pour multi-instance.
# Type: text | Niveau: expert
LUMENA_PUBLIC_BASE_URL=

# Dossier uploads/documents reçus
# Dossier de réception des fichiers (images, documents). Défaut : data/received_documents. Nécessite un redémarrage.
# Type: text | Niveau: expert
# Redémarrage requis après modification
LUMENA_UPLOADS_DIR=

# Rôle de l'instance
# standalone = instance autonome complète. primary = instance principale (gère tous les services). worker = instance secondaire (chat uniquement, sans bots ni crons).
# Type: select | Niveau: avancé
# Redémarrage requis après modification
# Options: standalone, primary, worker
LUMENA_INSTANCE_ROLE=standalone

# Découverte LAN des pairs Lumena
# Active le scan LAN pour détecter d'autres instances Lumena sur le réseau. Désactivé par défaut (mode local-privé). Nécessite redémarrage.
# Type: bool | Niveau: avancé
LUMENA_PEER_DISCOVERY=0

# Découverte mDNS/Zeroconf
# Active la découverte automatique via _lumena._tcp.local. Requiert python-zeroconf (pip install zeroconf). Aucun secret diffusé — le pairing reste obligatoire. Désactivé par défaut.
# Type: bool | Niveau: avancé
LUMENA_MDNS_DISCOVERY=0

# Conscience réseau dans le chat
# Injecte un résumé des pairs Lumena trusted dans le contexte agent. Lumena peut ainsi répondre à 'as-tu d'autres Lumena ?' avec l'état réel du réseau. Activez après avoir jumelé au moins un pair.
# Type: bool | Niveau: avancé
LUMENA_PEER_AWARENESS=0

# Délégation inter-instances
# Active le tool delegate_to_peer pour l'agent. Requiert LUMENA_PEER_AWARENESS=1 et au moins un pair trusted avec peer_token_outbound. Permet à Lumena de déléguer des tâches à d'autres instances Lumena.
# Type: bool | Niveau: avancé
LUMENA_PEER_COLLABORATION=0

# Autonomie réseau inter-Lumena
# Active les checks automatiques de santé et la découverte assistée des pairs. Ne fait jamais de trust automatique : le jumelage reste obligatoire.
# Type: bool | Niveau: avancé
LUMENA_PEER_NETWORK_AUTONOMY=0

# Intervalle health pairs (sec)
# Fréquence des checks automatiques des pairs connus. 60 secondes par défaut.
# Type: number | Niveau: avancé
LUMENA_PEER_AUTOHEALTH_INTERVAL_SEC=60

# Intervalle scan LAN auto (sec)
# Fréquence du scan LAN automatique quand LUMENA_PEER_DISCOVERY=1. 300 secondes par défaut.
# Type: number | Niveau: avancé
LUMENA_PEER_AUTOSCAN_INTERVAL_SEC=300

# Max hops inter-instances
# Nombre maximum de sauts autorisés pour un message inter-Lumena (enveloppe). Empêche les boucles de délégation. 5 = défaut (couvre la majorité des topologies). Diminuer pour isoler les instances.
# Type: number | Niveau: avancé
LUMENA_PEER_MAX_HOPS=5

# TTL max messages inter-instances (sec)
# Durée de vie maximale en secondes d'un message inter-Lumena. Les messages plus anciens que ce TTL sont refusés. 3600 = 1 heure (défaut).
# Type: number | Niveau: avancé
LUMENA_PEER_MAX_TTL=3600

# Taille max payload inter-instances (octets)
# Taille maximale du payload JSON d'un message inter-Lumena en octets. 65536 = 64 KiB (défaut). Augmenter pour artifact.share ou knowledge.share avec contenu volumineux.
# Type: number | Niveau: avancé
LUMENA_PEER_MAX_PAYLOAD_BYTES=65536

# Capacités supplémentaires déclarées
# Capacités custom à déclarer aux pairs Lumena (ex: gpu,tts). Séparées par virgule. Visibles via GET /api/instance/capabilities.
# Type: text | Niveau: avancé
LUMENA_EXTRA_CAPABILITIES=

# Token admin (auth API protégée)
# Token secret pour les routes admin (/api/peers, /api/peer/delegate, etc.). Auto-généré au démarrage si vide. Changer nécessite un redémarrage.
# Type: secret | Niveau: avancé
LUMENA_ADMIN_TOKEN=

# === Interface ===
# Zoom Desktop
# Zoom applique uniquement a la fenetre pywebview desktop. 0.90 = interface moins grosse, 1.0 = taille navigateur normale.
# Type: number | Niveau: avancé
LUMENA_DESKTOP_ZOOM=0.90

# Console Desktop visible au demarrage
# 0 = masque la fenetre console/logs au lancement Desktop. 1 = affiche la console au prochain demarrage pour debug.
# Type: bool | Niveau: avancé
# Redémarrage requis après modification
LUMENA_DESKTOP_SHOW_CONSOLE=0

# Splash Desktop au demarrage
# 1 = affiche une petite fenetre Lumena pendant l'initialisation du serveur local. 0 = demarrage sans splash.
# Type: bool | Niveau: avancé
# Redémarrage requis après modification
LUMENA_DESKTOP_SPLASH=1

# === LLM ===
# OpenAI reasoning effort
# Option envoyee aux modeles OpenAI modernes (GPT-5.x/o-series). Vide = defaut API, medium pour GPT-5.5.
# Type: select | Niveau: avancé
# Options: , none, low, medium, high, xhigh
LUMENA_OPENAI_REASONING_EFFORT=

# Modèle par défaut
# Modèle LLM utilisé par défaut pour toutes les requêtes. DeepSeek-V3 offre le meilleur rapport qualité/prix. Les cerveaux spécialisés ci-dessous peuvent surcharger ce choix.
# Type: select | Niveau: simple
# Options: qwen3-8b, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4o, gpt-5.4-nano, gpt-4o-mini, gpt-4.1, o3, o4-mini, gpt-5.3-codex, claude-opus-4.8, claude-fable-5, claude-mythos-5, claude-opus-4.7, claude-opus-4.6, claude-opus-4.5, claude-sonnet-4.6, claude-sonnet-4.5, claude-haiku-4.5, gemini-3.5-flash, gemini-3.1-pro, gemini-2.5-flash, gemini-2.5-pro, kimi-k2.7-code, kimi-k2.5, kimi-k2.6, kimi-k2-0905-preview, kimi-k2-turbo-preview, kimi-k2-thinking, kimi-k2-thinking-turbo, grok-4.3, grok-4-1-fast-reasoning, grok-4-1-fast-non-reasoning, grok-4.20-0309-reasoning, grok-4.20-0309-non-reasoning, grok-4.20-multi-agent-0309, nvidia-deepseek-v4-flash, nvidia-deepseek-v4-pro, nvidia-gpt-oss-120b, nvidia-step-3.7-flash, nvidia-kimi-k2.6, nvidia-glm-5.1, nvidia-nemotron-3-ultra-550b-a55b, nvidia-minimax-m2.7, nvidia-minimax-m3, nvidia-gemma-4-31b-it, minimax-m3, minimax-m2.5, minimax-m2.5-highspeed, minimax-m2.1, minimax-m2.1-highspeed, minimax-m2.7, glm-5.1, glm-4.7-flashx, glm-4.7-flash, glm-4.5-flash, glm-4.6v-flash, glm-5v-turbo, mistral-large, codestral, devstral, mistral-small, magistral-medium, ministral-8b, deepseek-v4-flash, deepseek-v4-pro, deepseek-v3, deepseek-reasoner
LUMENA_DEFAULT_MODEL=deepseek-v3

# Auto-switch DeepSeek → Reasoner (code)
# Bascule automatique de deepseek-chat vers deepseek-reasoner sur les tâches de code lourdes (évite la truncation sur longs contextes). Désactiver si tu utilises un modèle non-DeepSeek ou pour forcer la vitesse.
# Type: bool | Niveau: avancé
LUMENA_CODE_AUTOSWITCH_REASONER=1

# Architect max_tokens (CodeAgent)
# Nombre max de tokens pour la phase Architect (plan de modif). 4000 = plan court, truncation fréquente sur plans complexes. 12000 = plan détaillé sans troncature. Augmente si TRONCATURE DÉTECTÉE dans les logs.
# Type: number | Niveau: avancé
LUMENA_ARCHITECT_MAX_TOKENS=12000

# Architect max fichiers injectés
# Nombre max de fichiers dont le contenu est donné à l'Architect pour planifier. 4 = rapide, focus (défaut). 8-12 = refactors multi-fichiers. >15 = Opus/Gemini uniquement (DeepSeek Reasoner sature).
# Type: number | Niveau: avancé
LUMENA_ARCHITECT_MAX_FILES=4

# Architect timeout (sec)
# Timeout max de la phase Architect (plan). 600s = 10 min (défaut, couvre DeepSeek Reasoner CoT long). Descendre à 180-300 pour Kimi/Opus/GPT plus rapides.
# Type: number | Niveau: avancé
LUMENA_ARCHITECT_TIMEOUT=600

# CodeAgent max itérations
# Nombre max d'itérations THOUGHT→ACTION→OBSERVATION du CodeAgent avant arrêt forcé. 50 convient pour la majorité. Augmenter pour refactors très longs.
# Type: number | Niveau: avancé
LUMENA_CODE_AGENT_MAX_ITER=50

# CodeAgent retries externes
# Nombre de relances complètes du CodeAgent si la boucle interne échoue (budget total ≈ max_iter × max_outer_retries).
# Type: number | Niveau: avancé
LUMENA_CODE_AGENT_MAX_OUTER_RETRIES=3

# CodeAgent fenêtre contexte (tokens)
# Taille max de la fenêtre de contexte maintenue par le CodeAgent. 65536 = 64k (défaut). Augmenter pour Opus/Gemini 200k+. Diminuer pour économiser les tokens.
# Type: number | Niveau: avancé
LUMENA_CODE_AGENT_CONTEXT_WINDOW=65536

# SubAgent timeout global (sec)
# Timeout global d'exécution d'un SubAgent (CodeAgent, ResearchAgent…). 0 = pas de limite. Sinon en secondes.
# Type: number | Niveau: avancé
LUMENA_SUBAGENT_TIMEOUT=0

# SSE streaming timeout (sec)
# Timeout d'un appel LLM en streaming SSE côté SubAgent. 300 = 5 min (défaut). Augmenter pour Reasoner CoT très long.
# Type: number | Niveau: avancé
LUMENA_SSE_TIMEOUT_SECONDS=300

# PlannerAgent max parallélisme
# Nombre max de sous-tâches exécutées en parallèle par le PlannerAgent. 3 = défaut (équilibre rate-limits/latence).
# Type: number | Niveau: avancé
LUMENA_PLAN_MAX_PARALLEL=3

# Historique observations (chars)
# Fallback utilisé uniquement si aucun modèle actif. Le budget réel est auto-calibré par fenêtre contexte (2k→48k selon le modèle).
# Type: number | Niveau: avancé
LUMENA_REACT_HISTORY_OBS_CHARS=8000

# Override budget obs (chars)
# Force un budget d'observation fixe pour tous les modèles. Vide = auto calibré (recommandé). Utile pour debug ou contrainte GPU.
# Type: number | Niveau: avancé
LUMENA_REACT_OBS_LIMIT=

# Clamp budget obs (min:max)
# Format 'min:max' (ex 4000:64000). Borne la calibration automatique. Vide = pas de clamp.
# Type: text | Niveau: avancé
LUMENA_REACT_OBS_CLAMP=

# Protéger obs lecteur
# Si actif, la dernière observation de read_file / grep_search / web_fetch / list_directory reste intacte (pas de microcompaction). Indispensable pour raisonner sur des contenus longs.
# Type: select | Niveau: avancé
# Options: 1, 0
LUMENA_REACT_PROTECT_LAST_READ=1

# Max itérations ReAct
# Nombre maximum de cycles THOUGHT→ACTION→OBSERVATION avant arrêt forcé. 25 convient pour la majorité des tâches.
# Type: number | Niveau: avancé
LUMENA_MAX_REACT_ITERATIONS=25

# Min itérations ReAct
# Plancher garanti d'itérations. Empêche les boucles trop courtes même si un appel interne réduit le max.
# Type: number | Niveau: avancé
LUMENA_MIN_REACT_ITERATIONS=8

# Timeout global ReAct (sec)
# Durée max d'une boucle ReAct complète en secondes. 3600 = 1 heure. Protège contre les tâches infinies.
# Type: number | Niveau: avancé
LUMENA_REACT_TIMEOUT=3600

# Timeout étape externe (0=off)
# Timeout par étape individuelle d'une tâche déléguée. 0 = pas de limite. Utile pour les tâches planifiées.
# Type: number | Niveau: avancé
LUMENA_TASK_STEP_TIMEOUT_SEC=0

# Retries par étape
# Nombre de tentatives si une étape échoue par timeout. 1 = un seul essai.
# Type: number | Niveau: avancé
LUMENA_TASK_STEP_TIMEOUT_RETRIES=1

# Timeout tâche conversationnelle (secondes)
# Durée max d'exécution d'une tâche planifiée conversationnelle (CRON). 1800 = 30 min.
# Type: number | Niveau: avancé
LUMENA_CONV_TASK_TIMEOUT=1800

# Max outils en parallèle
# Nombre max d'outils exécutés simultanément via parallel_tools. 20 = défaut. Lumena choisit librement quels outils paralléliser (seule la récursion est interdite).
# Type: number | Niveau: avancé
LUMENA_PARALLEL_TOOL_MAX_CALLS=20

# ReAct : shell dans projets suivis
# Autorise ReAct à exécuter des commandes shell (run_command, run_shell) dans un projet suivi par Lumena, quand la policy le permet. Comportement recommandé : activé. Désactiver pour forcer la délégation au CodeAgent sur toute commande shell en projet.
# Type: bool | Niveau: avancé
LUMENA_REACT_ALLOW_PROJECT_SHELL=1

# URL Ollama
# URL du serveur Ollama local. Changer si Ollama tourne sur un autre port ou une autre machine.
# Type: text | Niveau: avancé
LUMENA_OLLAMA_HOST=http://localhost:11434

# Auto-détection modèles Ollama
# Si actif, Lumena interroge /api/show à chaque modèle Ollama custom pour récupérer son vrai context_length + capabilities (vision, tools). 0 = heuristique nom-only.
# Type: select | Niveau: avancé
# Options: 1, 0
LUMENA_OLLAMA_PROBE=1

# TTL cache probe Ollama (sec)
# Durée de vie du cache de probes Ollama. 86400 = 24h. Après expiration, /api/show est re-interrogé au prochain boot.
# Type: number | Niveau: avancé
LUMENA_OLLAMA_PROBE_TTL=86400

# === MCP ===
# Mode live MCP global
# 1 = autorise les mutations live MCP (install/activate/approve réels). 0 = dry-run forcé côté UI. Les confirmations backend restent obligatoires. Redémarrage requis pour propager aux singletons.
# Type: bool | Niveau: avancé
LUMENA_MCP_LIVE=0

# Live Auto-Approve MCP
# 1 = autorise les mutations live sur l'engine Auto-Approve (add/remove/update patterns). Nécessite aussi LUMENA_MCP_LIVE=1 selon la doctrine double opt-in.
# Type: bool | Niveau: avancé
LUMENA_MCP_AUTOAPPROVE_LIVE=0

# Auto-Approve agent MCP
# 1 = autorise ReAct à approuver et exécuter automatiquement les tickets MCP si une règle Auto-Approve matche. Nécessite LUMENA_MCP_LIVE=1 et reste soumis aux kill switches install/activation.
# Type: bool | Niveau: avancé
LUMENA_MCP_AGENT_AUTOAPPROVE_LIVE=0

# Live Trust MCP
# 1 = autorise la mise à jour manuelle du trust_score d'un serveur catalog. Opt-in dédié à la mutation Trust côté UI.
# Type: bool | Niveau: avancé
LUMENA_MCP_TRUST_LIVE=0

# Activer boucle ReAct MCP
# 1 = expose request_mcp_capability et request_mcp_ticket dans ReAct. Redémarrage requis pour attacher les outils MCP conversationnels.
# Type: bool | Niveau: avancé
# Redémarrage requis après modification
LUMENA_MCP_REACT_INTEGRATION_ENABLED=0

# Recherche réseau MCP
# 1 = autorise la recherche read-only dans les registres publics MCP compatibles (npm + lookup PyPI). 0 = sources locales/offline uniquement. Redémarrage requis pour propager.
# Type: bool | Niveau: avancé
# Redémarrage requis après modification
LUMENA_MCP_NETWORK_SEARCH_ENABLED=1

# Désactiver install MCP
# Kill switch : 1 = bloque toute action d'installation MCP côté UI (retour 503 propre). Indépendant de LUMENA_MCP_LIVE.
# Type: bool | Niveau: avancé
LUMENA_MCP_INSTALL_DISABLED=0

# Désactiver activation MCP
# Kill switch : 1 = bloque activate/deactivate/quarantine côté UI (retour 503 propre). Indépendant de LUMENA_MCP_LIVE.
# Type: bool | Niveau: avancé
LUMENA_MCP_ACTIVATION_DISABLED=0

# Dossier racine MCP
# Chemin absolu du dossier racine où les serveurs MCP sont installés. Vide = défaut interne (data/mcp). Redémarrage requis pour propager.
# Type: text | Niveau: avancé
LUMENA_MCP_ROOT=

# Cache curated MCP
# Chemin absolu du dossier du cache curated MCP (utilisateur). Vide = défaut DATA_DIR/mcp_curated/. Le cache n'est jamais commité.
# Type: text | Niveau: avancé
LUMENA_MCP_CURATED_CACHE_DIR=

# Préférer natif par défaut
# 1 = quand un outil natif et un MCP couvrent la même capacité, on affiche le natif. L'utilisateur peut basculer par MCP via set_mcp_preference.
# Type: bool | Niveau: avancé
LUMENA_MCP_PREFER_NATIVE_DEFAULT=1

# Seuil trust_score auto-approve
# Trust_score minimal d'un MCP pour qu'il soit auto-approuvé (sous réserve des kill switches).
# Type: number | Niveau: avancé
LUMENA_MCP_AUTO_TRUST_THRESHOLD=80

# Détection overlap natifs/MCP
# 1 = à l'activation d'un MCP, Lumena détecte les overlaps avec les outils natifs et applique la préférence pour éviter le double affichage.
# Type: bool | Niveau: avancé
LUMENA_MCP_OVERLAP_DETECTION_ENABLED=1

# Désactiver transport remote
# Kill switch sécurité : 1 = bloque les transports HTTP/SSE distants des serveurs MCP. 0 = autorise les MCPs en remote (avancé).
# Type: bool | Niveau: avancé
LUMENA_MCP_REMOTE_TRANSPORT_DISABLED=1

# === Ops ===
# Age max archive (jours)
# Les archives (backups, logs anciens) de plus de X jours sont supprimées automatiquement.
# Type: number | Niveau: expert
LUMENA_ARCHIVE_MAX_AGE_DAYS=30

# Taille max archives (GB)
# Taille maximale totale du dossier d'archives en Go. Au-delà, les plus anciennes sont purgées.
# Type: number | Niveau: expert
LUMENA_ARCHIVE_MAX_SIZE_GB=10

# Purge mémoire active
# Active la purge automatique des souvenirs ChromaDB les plus anciens quand la base dépasse le seuil.
# Type: bool | Niveau: expert
LUMENA_OPS_MEMORY_PURGE_ENABLED=1

# === Paiements ===
# Stripe Secret Key
# Clé secrète Stripe (sk_test_... ou sk_live_...). Permet de créer produits, prix, liens de paiement, gérer clients et abonnements. Obtenir sur dashboard.stripe.com/apikeys
# Type: secret | Niveau: simple
STRIPE_API_KEY=

# Stripe Webhook Secret
# Secret de vérification des webhooks Stripe (whsec_...). Requis pour recevoir les événements (paiement réussi, abonnement annulé, etc.). Configurer sur dashboard.stripe.com/webhooks
# Type: secret | Niveau: simple
STRIPE_WEBHOOK_SECRET=

# Mode Stripe
# test = mode sandbox (pas de vrais paiements) | live = production (paiements réels). Commencer par test pour valider l'intégration.
# Type: select | Niveau: simple
# Options: test, live
STRIPE_MODE=test

# Stripe CLI Auto-Start
# Démarre automatiquement `stripe listen` au lancement de Lumena pour recevoir les webhooks en local. Désactiver si Lumena est hébergée avec un vrai domaine.
# Type: bool | Niveau: simple
STRIPE_CLI_AUTO=1

# === Préférences ===
# Utiliser des emojis
# Lumena utilise des emojis dans ses réponses. 1 = oui, 0 = non.
# Type: bool | Niveau: simple
LUMENA_USE_EMOJIS=1

# Activer le système émotionnel
# Active le système émotionnel complet (PAD, persistance, injection prompt, dashboard). 0 = désactivé.
# Type: bool | Niveau: avancé
LUMENA_EMOTION_ENABLED=1

# Humeur par défaut
# Humeur de base de Lumena. Influence son ton et son style de réponse.
# Type: select | Niveau: simple
# Options: neutral, happy, curious, playful, excited, thoughtful, tired, bored, proud, touched
LUMENA_DEFAULT_MOOD=neutral

# Fréquence des emojis
# Pourcentage de messages avec emojis (0 = jamais, 100 = toujours).
# Type: range | Niveau: avancé
LUMENA_EMOJI_FREQUENCY=30

# Humeurs autorisées
# Liste d'humeurs séparées par virgules (ex: happy,curious,neutral). Vide = toutes.
# Type: text | Niveau: avancé
LUMENA_ENABLED_MOODS=

# Vitesse de decay émotionnel
# Vitesse de retour vers neutre (0.01 = lent, 0.1 = rapide).
# Type: text | Niveau: avancé
LUMENA_EMOTION_DECAY=0.02

# Analyse sentimentale LLM
# Utilise le LLM pour détecter le sentiment des messages (plus précis). 0 = fallback keyword uniquement.
# Type: bool | Niveau: avancé
LUMENA_EMOTION_LLM_ANALYSIS=1

# Sensibilité émotionnelle
# Sensibilité émotionnelle (0 = stoïque, 0.5 = normal, 1 = hypersensible). Multiplie les deltas PAD.
# Type: text | Niveau: avancé
LUMENA_EMOTION_SENSITIVITY=0.5

# Preset personnalité
# Applique un preset de traits. Les valeurs individuelles LUMENA_TRAIT_* ont priorité.
# Type: select | Niveau: avancé
# Options: , professional, creative, companion
LUMENA_PERSONALITY_PRESET=

# Thème documents
# Thème par défaut pour les PDF/DOCX générés. Vide = corporate.
# Type: select | Niveau: avancé
# Options: , corporate, minimal, modern, legal, creative
LUMENA_DOCUMENT_THEME=

# === SLO ===
# Seuil erreurs workspace
# Nombre max d'erreurs tolérées dans le workspace avant déclenchement d'une alerte SLO.
# Type: number | Niveau: expert
LUMENA_SLO_WORKSPACE_ERRORS_MAX=999

# === Serveur ===
# Port du serveur web
# Port d'écoute du serveur FastAPI. 8080 par défaut. Nécessite un redémarrage.
# Type: number | Niveau: avancé
# Redémarrage requis après modification
LUMENA_PORT=8080

# Host du serveur web
# Adresse d'écoute. 0.0.0.0 = accessible réseau. 127.0.0.1 = local uniquement. Nécessite un redémarrage.
# Type: text | Niveau: avancé
# Redémarrage requis après modification
LUMENA_HOST=0.0.0.0

# CORS origins autorisées
# Origines CORS supplémentaires séparées par des virgules (ex: http://mon-domaine.fr). Vide = localhost uniquement.
# Type: text | Niveau: avancé
LUMENA_CORS_ORIGINS=

# Rate limit requêtes lourdes (req/min)
# Max requêtes/minute pour /api/chat et /api/upload. 20 par défaut.
# Type: number | Niveau: avancé
LUMENA_RATE_EXPENSIVE=20

# Rate limit requêtes standard (req/min)
# Max requêtes/minute pour la plupart des endpoints API. 200 par défaut.
# Type: number | Niveau: avancé
LUMENA_RATE_DEFAULT=200

# Rate limit health/status (req/min)
# Max requêtes/minute pour /api/health et /api/status. 600 par défaut.
# Type: number | Niveau: avancé
LUMENA_RATE_HEALTH=600

# === SubAgents ===
# CodeAgent — modèle
# Modèle utilisé par le CodeAgent (write/edit/run code). auto = routage automatique (recommandé). Forcer Kimi K2.5 / Opus / DeepSeek-reasoner pour refactors lourds.
# Type: select | Niveau: avancé
# Options: auto, qwen3-8b, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4o, gpt-5.4-nano, gpt-4o-mini, gpt-4.1, o3, o4-mini, gpt-5.3-codex, claude-opus-4.8, claude-fable-5, claude-mythos-5, claude-opus-4.7, claude-opus-4.6, claude-opus-4.5, claude-sonnet-4.6, claude-sonnet-4.5, claude-haiku-4.5, gemini-3.5-flash, gemini-3.1-pro, gemini-2.5-flash, gemini-2.5-pro, kimi-k2.7-code, kimi-k2.5, kimi-k2.6, kimi-k2-0905-preview, kimi-k2-turbo-preview, kimi-k2-thinking, kimi-k2-thinking-turbo, grok-4.3, grok-4-1-fast-reasoning, grok-4-1-fast-non-reasoning, grok-4.20-0309-reasoning, grok-4.20-0309-non-reasoning, grok-4.20-multi-agent-0309, nvidia-deepseek-v4-flash, nvidia-deepseek-v4-pro, nvidia-gpt-oss-120b, nvidia-step-3.7-flash, nvidia-kimi-k2.6, nvidia-glm-5.1, nvidia-nemotron-3-ultra-550b-a55b, nvidia-minimax-m2.7, nvidia-minimax-m3, nvidia-gemma-4-31b-it, minimax-m3, minimax-m2.5, minimax-m2.5-highspeed, minimax-m2.1, minimax-m2.1-highspeed, minimax-m2.7, glm-5.1, glm-4.7-flashx, glm-4.7-flash, glm-4.5-flash, glm-4.6v-flash, glm-5v-turbo, mistral-large, codestral, devstral, mistral-small, magistral-medium, ministral-8b, deepseek-v4-flash, deepseek-v4-pro, deepseek-v3, deepseek-reasoner
LUMENA_AGENT_CODE_MODEL=auto

# ResearchAgent — modèle
