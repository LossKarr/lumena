# === Système ===
# Setup initial terminé
# Passe à 1 après le wizard de première installation. Ne pas modifier manuellement sauf pour relancer le setup.
# Type: bool | Niveau: expert
LUMENA_SETUP_COMPLETE=0

# Mode Sandbox Docker
# auto = commandes système en local + code en Docker | always = tout Docker | never = pas de Docker
# Type: select | Niveau: expert
# Options: auto, always, never
LUMENA_SANDBOX_MODE=auto

# Mémoire conteneur Docker
# Limite mémoire RAM du conteneur sandbox Docker (ex: 512m, 1g). 512m par défaut.
# Type: text | Niveau: avancé
LUMENA_SANDBOX_MEMORY=512m

# === Telegram ===
# Désactiver Telegram
# Désactive complètement le canal Telegram au démarrage. Utile si pas de bot configuré.
# Type: bool | Niveau: simple
LUMENA_DISABLE_TELEGRAM=

# Mode Web uniquement
# Force tous les canaux sur Web uniquement. Désactive Telegram, WhatsApp, Discord et CLI.
# Type: bool | Niveau: simple
LUMENA_WEB_ONLY=

# === Vidéo ===
# Remotion License Key
# Optionnel. Gratuit pour individus et orgas ≤3 personnes. Requis pour entreprises >3. Obtenir sur remotion.pro. Laisser vide = mode gratuit.
# Type: secret | Niveau: avancé
REMOTION_LICENSE_KEY=

# Image Docker vidéo
# Image Docker pour la génération vidéo Remotion. Doit contenir Node.js ≥16 et npm.
# Type: text | Niveau: avancé
LUMENA_VIDEO_DOCKER_IMAGE=node:20-slim

# Timeout rendu vidéo (sec)
# Timeout maximum pour le rendu d'une vidéo. Augmenter pour les vidéos longues (>60s).
# Type: number | Niveau: avancé
LUMENA_VIDEO_RENDER_TIMEOUT=300

# Accélération GPU vidéo
# Activer le rendu GPU (NVIDIA). Nécessite nvidia-container-toolkit + Docker runtime nvidia. Accélère le rendu 3-5×.
# Type: bool | Niveau: avancé
LUMENA_VIDEO_GPU=0

# === Voix ===
# Auto-démarrage voix
# Démarre automatiquement l'écoute micro au lancement. 0 = activation manuelle uniquement.
# Type: bool | Niveau: simple
LUMENA_VOICE_AUTO=0

# TTS automatique
# Lit automatiquement les réponses à voix haute. 0 = texte uniquement sauf demande explicite.
# Type: bool | Niveau: simple
LUMENA_TTS_AUTO=0

# Mode TTS (fast/premium/offline)
# fast = pyttsx3 local rapide | premium = edge-tts Microsoft (meilleure qualité) | offline = Piper ONNX local
# Type: select | Niveau: simple
# Redémarrage requis après modification
# Options: fast, premium, offline
LUMENA_TTS_MODE=premium

# Modèle Whisper
# Taille du modèle Whisper pour la reconnaissance vocale. Plus gros = plus précis mais plus lent et plus de VRAM.
# Type: select | Niveau: simple
# Redémarrage requis après modification
# Options: tiny, base, small, medium, large-v3-turbo
LUMENA_STT_MODEL=large-v3-turbo

# Timeout conversation (sec)
# Durée max d'écoute vocale continue avant arrêt automatique. 45s = par défaut.
# Type: number | Niveau: avancé
LUMENA_VOICE_CONV_TIMEOUT=45

# TTS Telegram
# Envoie les réponses en message vocal Telegram en plus du texte.
# Type: bool | Niveau: avancé
LUMENA_TTS_TELEGRAM=0

# TTS WhatsApp
# Envoie les réponses en message vocal WhatsApp en plus du texte.
# Type: bool | Niveau: avancé
LUMENA_TTS_WHATSAPP=0

# === WhatsApp ===
# WhatsApp Access Token
# Token permanent (System User recommandé). Depuis developers.facebook.com
# Type: secret | Niveau: simple
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Phone Number ID
# ID du numéro Business (pas le numéro lui-même). Visible dans le dashboard Meta.
# Type: text | Niveau: avancé
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Verify Token
# Token arbitraire choisi par toi pour la vérification webhook Meta.
# Type: text | Niveau: avancé
WHATSAPP_VERIFY_TOKEN=lumena_wa_verify

# WhatsApp App Secret
# App Secret (optionnel mais recommandé pour HMAC signature). Settings > Basic dans l'app Facebook.
# Type: secret | Niveau: simple
WHATSAPP_APP_SECRET=

# Numéro owner WhatsApp
# Numéro du propriétaire au format international (ex: 33612345678). Pour les alertes proactives.
# Type: text | Niveau: avancé
WHATSAPP_OWNER_PHONE=

# Désactiver WhatsApp
# Mettre à 1 pour désactiver le channel WhatsApp (désactivé par défaut — credentials Meta requis).
# Type: bool | Niveau: simple
LUMENA_DISABLE_WHATSAPP=1


#======================================================================
# VARIABLES AVANCÉES (non présentes dans le wizard)
# Valeurs par défaut — modifier uniquement si nécessaire.
#======================================================================

# --- Agents ---
# CodeAgent pour create_project (1=on, 0=force batch)
# LUMENA_PROJECT_VIA_CODEAGENT=1

# --- Alertes (avancé) ---
# URL TwiML pour appels critiques
# LUMENA_CRITICAL_CALL_TWIML_URL=

# --- Autonomie (avancé) ---
# Skill quotidien activé
# LUMENA_AUTONOMY_DAILY_SKILL_ENABLE=True

# Dry run skill quotidien
# LUMENA_AUTONOMY_DAILY_SKILL_DRY_RUN=False

# Timeout recherche autonome (sec)
# LUMENA_AUTONOMY_RESEARCH_TIMEOUT_SEC=900

# Cooldown répétition action (sec)
# LUMENA_AUTONOMY_ACTION_REPEAT_COOLDOWN_SEC=900

# --- Browser (avancé) ---
# URL proxy navigateur
# LUMENA_BROWSER_PROXY=

# --- Clés API (non-wizard) ---
# Chat ID Telegram (envoi direct)
# TELEGRAM_CHAT_ID=

# Alias de TELEGRAM_TOKEN (legacy)
# TELEGRAM_BOT_TOKEN=

# Alias de DISCORD_TOKEN (legacy)
# DISCORD_BOT_TOKEN=

# ID du serveur Discord
# DISCORD_GUILD_ID=

# Préfixe commandes Discord
# DISCORD_PREFIX=!

# User IDs admin Discord (CSV)
# DISCORD_ADMIN_IDS=

# Role IDs admin Discord (CSV)
# DISCORD_ADMIN_ROLE_IDS=

# Noms rôles admin Discord (CSV)
# DISCORD_ADMIN_ROLES=admin,administrateur,moderateur,lumena-admin

# Channel ID global Discord (alias)
# DISCORD_GLOBAL_CHANNEL_ID=

# Clé API Shodan (scan réseau)
# SHODAN_API_KEY=

# Bearer token Twitter/X
# TWITTER_BEARER_TOKEN=

# API key Twitter/X
# TWITTER_API_KEY=

# API secret Twitter/X
# TWITTER_API_SECRET=

# Access token Twitter/X
# TWITTER_ACCESS_TOKEN=

# Access token secret Twitter/X
# TWITTER_ACCESS_TOKEN_SECRET=

# URI redirect OAuth Spotify
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# URL base API Moonshot/Kimi
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# URL Ollama (legacy, utiliser LUMENA_OLLAMA_HOST)
# OLLAMA_HOST=http://localhost:11434

# Alias GOOGLE_API_KEY (Gemini)
# GEMINI_API_KEY=

# Alias legacy modèle par défaut
# DEFAULT_MODEL=

# --- CodeAgent (flags) ---
# P0 — Prompts adaptés par provider
# LUMENA_PROVIDER_PROMPTS=true

# P0b — Descriptions détaillées par outil
# LUMENA_TOOL_HINTS=true

# P1 — Fuzzy matching multi-passes str_replace/apply_patch
# LUMENA_FUZZY_REPLACE=true

# P2 — Compaction progressive avec pruning intelligent
# LUMENA_COMPACTION_PRUNE=true

# P3 — Mode plan (read-only puis exécution)
# LUMENA_PLAN_MODE=true

# P4 — Sauvegarde outputs tronqués dans data/logs/codeagent/
# LUMENA_TRUNCATION_SAVE=true

# P5 — Escalation graceful avant max_iter
# LUMENA_MAX_STEPS_GRACEFUL=true

# P6 — Auto-format (ruff/prettier) post-edit
# LUMENA_AUTO_FORMAT=true

# P7 — Quality gates ReAct (parité CodeAgent)
# LUMENA_REACT_QUALITY_GATES=true

# P8 — Suggestion outil similaire si nom invalide
# LUMENA_DID_YOU_MEAN=true

# P8 — Températures adaptées par provider
# LUMENA_MODEL_TEMPERATURES=true

# P8 — Replay derniers turns après compaction
# LUMENA_COMPACTION_REPLAY=true

# P8 — Catch + correction outils inconnus
# LUMENA_INVALID_TOOL_CATCH=true

# P8 — Normalisation CR/LF Windows<->Unix
# LUMENA_CRLF_NORMALIZE=true

# P8 — Inject OS/shell/cwd dans system prompt
# LUMENA_ENV_CONTEXT=true

# P8 — Timeout adaptatif streaming SSE
# LUMENA_SSE_TIMEOUT=true

# P8 — Prompt caching Anthropic/DeepSeek
# LUMENA_PROMPT_CACHE=true

# P10 — Métriques coding -> data/logs/codeagent/metrics.jsonl
# LUMENA_CODING_METRICS=true

# P11 — OPT-IN: confirmation rm/git push --force/etc.
# LUMENA_DESTRUCTIVE_CONFIRM=false

# P11 — Messages d'erreur en français
# LUMENA_FRENCH_ERRORS=true

# --- Compaction / Contexte ---
# Max tokens fenêtre contexte
# LUMENA_DEFAULT_CONTEXT_TOKENS=128000

# Seuil compaction (0.0-1.0)
# LUMENA_CONTEXT_COMPACTION_THRESHOLD=0.6

# --- Computer Use (avancé) ---
# Max pixels image pour LLM
# LUMENA_VISION_MAX_IMAGE_SIZE=1568

# Modèle Anthropic pour CU
# LUMENA_ANTHROPIC_CU_MODEL=claude-sonnet-4-20250514

# Modèle OpenAI pour CU
# LUMENA_OPENAI_CU_MODEL=computer-use-preview

# Ordre natif CU providers (CSV, vide = auto)
# LUMENA_CU_NATIVE_ORDER=

# Désactiver CU natif (1 = off)
# LUMENA_CU_NATIVE_DISABLED=0

# --- Core / Flags internes ---
# Auto-réparation finale agent
# LUMENA_AGENT_FINAL_REPAIR=True

# Migration auto mémoire ChromaDB
# LUMENA_MEMORY_AUTO_MIGRATE=True

# Activation auto des skills
# LUMENA_SKILLS_AUTO_ACTIVATION=True

# Désactiver routage par intention (1 = off)
# LUMENA_DISABLE_INTENT_ROUTING=

# Désactiver canal Discord (1 = off)
# LUMENA_DISABLE_DISCORD=

# Activer imports legacy channels (1 = on)
# LUMENA_CHANNELS_LEGACY_IMPORTS=

# --- Docker Sandbox (avancé) ---
# Image Docker sandbox
# LUMENA_SANDBOX_IMAGE=lumena-sandbox

# CPUs alloués au conteneur
# LUMENA_SANDBOX_CPUS=1

# Limite de PIDs Docker
# LUMENA_SANDBOX_PIDS_LIMIT=256

# Marge timeout startup Docker (sec)
# LUMENA_SANDBOX_STARTUP_MARGIN=30

# --- Email (avancé) ---
# Max pièces jointes
# LUMENA_MAIL_MAX_ATTACHMENTS=12

# Max taille PJ (MB)
# LUMENA_MAIL_MAX_ATTACHMENT_MB=20

# Max taille totale PJ (MB)
# LUMENA_MAIL_MAX_TOTAL_ATTACHMENTS_MB=45

# Dossiers autorisés pour PJ (CSV)
# LUMENA_MAIL_ALLOWED_ATTACHMENT_ROOTS=

# Délai retry SMTP (sec)
# LUMENA_MAIL_RETRY_DELAY_SEC=0.8

# Destinataires autorisés (CSV, vide = tous)
# LUMENA_MAIL_ALLOWED_RECIPIENTS=

# Domaines autorisés (CSV, vide = tous)
# LUMENA_MAIL_ALLOWED_DOMAINS=

# Timeout connexion SMTP (sec)
# LUMENA_MAIL_CONNECT_TIMEOUT_SEC=20

# Max envois par fenêtre rate limit
# LUMENA_MAIL_SEND_MAX_PER_WINDOW=30

# Fenêtre rate limit envoi (sec)
# LUMENA_MAIL_SEND_WINDOW_SEC=600

# Max destinataires par email
# LUMENA_MAIL_MAX_RECIPIENTS=20

# Max caractères body
# LUMENA_MAIL_MAX_BODY_CHARS=200000

# Max réponses par fenêtre
# LUMENA_MAIL_REPLY_MAX_PER_WINDOW=30

# Fenêtre rate limit réponse (sec)
# LUMENA_MAIL_REPLY_WINDOW_SEC=600

# Max downloads PJ par fenêtre
# LUMENA_MAIL_DOWNLOAD_ATTACHMENTS_MAX_PER_WINDOW=60

# Fenêtre download PJ (sec)
# LUMENA_MAIL_DOWNLOAD_ATTACHMENTS_WINDOW_SEC=600

# Max suppressions par fenêtre
# LUMENA_MAIL_DELETE_MAX_PER_WINDOW=100

# Fenêtre suppression (sec)
# LUMENA_MAIL_DELETE_WINDOW_SEC=600

# Max déplacements par fenêtre
# LUMENA_MAIL_MOVE_MAX_PER_WINDOW=150

# Fenêtre déplacement (sec)
# LUMENA_MAIL_MOVE_WINDOW_SEC=600

# --- Feature Flags ---
# Feature flag runtime V2
# LUMENA_RUNTIME_CONTEXT_V2=False

# Feature flag workspace policy V2
# LUMENA_WORKSPACE_POLICY_V2=False

# Feature flag orchestrateur V1
# LUMENA_TASK_ORCHESTRATOR_V1=False

# Feature flag stream event V2
# LUMENA_STREAM_EVENT_V2=False

# Feature flag omnichannel V1
# LUMENA_OMNICHANNEL_ENVELOPE_V1=False

# Mode instance unique (lock fichier)
# LUMENA_SINGLE_INSTANCE=True

# Autonomie activée sur web
# LUMENA_WEB_AUTONOMY_ENABLED=True

# --- File Edits / Undo ---
# Activer undo sur éditions fichiers
# LUMENA_UNDO_ENABLED=True

# Lignes de preview édition
# LUMENA_FILE_EDIT_PREVIEW_LINES=12

# Max chars par ligne preview
# LUMENA_FILE_EDIT_PREVIEW_LINE_MAX=240

# Max chars payload texte
# LUMENA_FILE_EDIT_PAYLOAD_TEXT_MAX=200000

# Max sessions d'édition
# LUMENA_FILE_EDIT_MAX_SESSIONS=120

# --- IDE / Éditeur ---
# Workspace par défaut
# LUMENA_DEFAULT_WORKSPACE=

# Max lignes lecture IDE
# LUMENA_IDE_READ_LINES=200000

# Max items listing IDE
# LUMENA_IDE_LIST_ITEMS=20000

# Timeout commande IDE (sec)
# LUMENA_IDE_COMMAND_TIMEOUT_SEC=120

# Limite output IDE (chars)
# LUMENA_IDE_OUTPUT_LIMIT=2000000

# Max résultats grep IDE
# LUMENA_IDE_GREP_RESULTS=10000

# Max taille fichier grep (MB)
# LUMENA_IDE_GREP_FILE_SIZE_MB=50

# Max résultats find IDE
# LUMENA_IDE_FIND_RESULTS=20000

# Port WebSocket IDE bridge
# LUMENA_IDE_WS_PORT=8245

# Chemin exécutable Cursor IDE
# LUMENA_CURSOR_IDE_PATH=

# --- IDE Context ---
# TTL contexte IDE (sec)
# LUMENA_IDE_CONTEXT_TTL_SEC=7200

# Max items contexte IDE
# LUMENA_IDE_CONTEXT_MAX_ITEMS=256

# --- Instance (avancé) ---
# Nombre max de contextes par plateforme (Telegram, Discord, etc.)
# LUMENA_MAX_CONTEXTS_PER_PLATFORM=500

# --- LLM (avancé) ---
# Concurrence max providers
# LUMENA_PROVIDER_CONCURRENCY=2

# Max échecs avant cooldown
# LUMENA_PROVIDER_MAX_FAILURES=3

# Cooldown provider (minutes)
# LUMENA_PROVIDER_COOLDOWN_MIN=5

# Ordre fallback providers (CSV, vide = auto)
# LUMENA_FALLBACK_ORDER=

# Max étapes continuation réponse
# LUMENA_MAX_CONTINUATION_STEPS=3

# Retries erreurs transientes (429/5xx)
# LUMENA_LLM_TRANSIENT_RETRIES=2

# Délais backoff retry (sec, CSV)
# LUMENA_LLM_RETRY_DELAYS=1.0,3.0

# --- Orchestrateur ---
# Chemin state orchestrateur (vide = auto)
# LUMENA_TASK_ORCHESTRATOR_STATE_PATH=

# --- Paths (avancé) ---
# Dossier des logs
# LUMENA_LOGS_DIR=data/logs

# Dossier des backups
# LUMENA_BACKUPS_DIR=./backups

# --- ReAct / Outils (avancé) ---
# Mode strict apply_patch
# LUMENA_PATCH_STRICT=1

# Afficher file cards dans chat
# LUMENA_CHAT_FILE_CARDS=1

# Timeout exécution outil (sec)
# LUMENA_TOOL_TIMEOUT=30

# Max itérations ReAct mode IDE
# LUMENA_MAX_REACT_ITERATIONS_IDE=35

# Timeout ReAct mode IDE (sec, vide = fallback)
# LUMENA_REACT_TIMEOUT_IDE=

# Chars obs historique ReAct IDE
# LUMENA_REACT_HISTORY_OBS_CHARS_IDE=12000

# Alias legacy modèle (fallback)
# LUMENA_MODEL=

# --- Réseau local ---
# Clé d'authentification pour scans réseau (WMI, SSH, etc.)
# NETWORK_KEY=

# Mot de passe pour scans réseau authentifiés
# NETWORK_PASS=

# --- SLO (avancé) ---
# Fenêtre SLO (samples)
# LUMENA_SLO_WINDOW_SIZE=300

# Alertes consécutives SLO
# LUMENA_SLO_ALERT_CONSECUTIVE=3

# Taux succès min SLO
# LUMENA_SLO_SUCCESS_RATE_MIN=0.92

# Taux timeout max SLO
# LUMENA_SLO_TIMEOUT_RATE_MAX=0.02

# Latence médiane max (ms)
# LUMENA_SLO_LATENCY_MEDIAN_MAX_MS=8000

# Latence P95 max (ms)
# LUMENA_SLO_LATENCY_P95_MAX_MS=35000

# Taux succès undo min
# LUMENA_SLO_UNDO_SUCCESS_RATE_MIN=1.0

# --- SSE / Streaming ---
# Auto-reprise après timeout
# LUMENA_TIMEOUT_AUTO_RESUME=True

# Backoff reprise timeout (sec)
# LUMENA_TIMEOUT_RESUME_BACKOFF_SEC=0.4

# Timeout global /api/chat (sec, 0 = off)
# LUMENA_CHAT_GLOBAL_TIMEOUT_SEC=0.0

# Timeout global stream (sec, 0 = off)
# LUMENA_STREAM_GLOBAL_TIMEOUT_SEC=0.0

# Max pensées SSE par stream
# LUMENA_SSE_MAX_THOUGHTS=600

# Intervalle heartbeat SSE (sec)
# LUMENA_SSE_HEARTBEAT_SEC=5

# --- Serveur (avancé) ---
# Fenêtre rate limit (sec)
# LUMENA_RATE_WINDOW=60

# --- Session / Conversation ---
# TTL state session (sec)
# LUMENA_SESSION_STATE_TTL_SEC=172800

# Max items state session
# LUMENA_SESSION_STATE_MAX_ITEMS=2048

# TTL conversation (sec)
# LUMENA_CONVERSATION_TTL_SEC=86400

# Max items conversation
# LUMENA_CONVERSATION_MAX_ITEMS=1024

# --- Telegram (avancé) ---
# Chemin fichier lock Telegram (vide = auto)
# LUMENA_TELEGRAM_LOCK_PATH=

# Timeout connexion (sec)
# LUMENA_TELEGRAM_CONNECT_TIMEOUT=15.0

# Timeout lecture (sec)
# LUMENA_TELEGRAM_READ_TIMEOUT=30.0

# Timeout écriture (sec)
# LUMENA_TELEGRAM_WRITE_TIMEOUT=30.0

# Pool timeout (sec)
# LUMENA_TELEGRAM_POOL_TIMEOUT=30.0

# Retries bootstrap
# LUMENA_TELEGRAM_BOOTSTRAP_RETRIES=1

# Retries startup
# LUMENA_TELEGRAM_STARTUP_RETRIES=2

# Délai retry startup (sec)
# LUMENA_TELEGRAM_STARTUP_RETRY_DELAY=2.0

# Chars preview document
# LUMENA_TELEGRAM_DOC_PREVIEW_CHARS=2500

# --- Twitter ---
# Désactiver canal Twitter (1 = off)
# LUMENA_DISABLE_TWITTER=

# Intervalle poll Twitter (sec)
# LUMENA_TWITTER_POLL_INTERVAL=90

# Max longueur tweet
# LUMENA_TWITTER_MAX_TWEET_LEN=280

# --- Télémétrie / Traces ---
# Activer bus de traces
# LUMENA_TRACE_ENABLED=True

# Taille buffer traces
# LUMENA_TRACE_BUFFER_SIZE=500

# Max longueur résumé trace
# LUMENA_TRACE_SUMMARY_MAX_LEN=280

# Intervalle heartbeat trace (sec)
# LUMENA_TRACE_HEARTBEAT_SEC=10

# --- Voix (avancé) ---
# Device Whisper (cuda/cpu)
# LUMENA_STT_DEVICE=cuda

# Type calcul Whisper (float16/int8)
# LUMENA_STT_COMPUTE=float16

# Index micro à utiliser (vide = auto)
# LUMENA_STT_MIC_INDEX=

# Multiplicateur seuil bruit ambiant
# LUMENA_STT_CALIBRATION_MULTIPLIER=2.5

# Timeout écoute wake word (sec)
# LUMENA_WAKE_WORD_TIMEOUT=3600

# --- WhatsApp (avancé) ---
# Timeout connexion (sec)
# LUMENA_WHATSAPP_CONNECT_TIMEOUT=15.0

# Timeout lecture (sec)
# LUMENA_WHATSAPP_READ_TIMEOUT=30.0

# Chars preview document
# LUMENA_WHATSAPP_DOC_PREVIEW_CHARS=2500

# Retries webhook processing
# LUMENA_WHATSAPP_WEBHOOK_MAX_RETRIES=3
