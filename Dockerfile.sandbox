# ============================================================
# LUMENA — Image Sandbox (exécution isolée de commandes)
# ============================================================
# Build :  docker build -f Dockerfile.sandbox -t lumena-sandbox .
# Usage :  Automatiquement utilisée par src/utils/docker_sandbox.py
# ============================================================

FROM python:3.12-slim

# ── Node.js 22 LTS ──────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        git \
        jq \
    && rm -rf /var/lib/apt/lists/*

# ── Utilisateur non-root ────────────────────────────────────
RUN useradd -m -s /bin/bash sandbox
USER sandbox
WORKDIR /work

# Vérification
RUN python3 --version && node --version && npm --version
